@startuml OctoTify_StateDiagram

title OctoTify 状态图 —— 核心实体生命周期

skinparam linetype ortho

state "Source 状态机" as source_sm {
    state "正常\n(Active)\nstatus = 1" as src_active
    state "禁用\n(Disabled)\nstatus = 2" as src_disabled
    state "已删除\n(Deleted)\nstatus = -1" as src_deleted

    [*] --> src_active : 创建 Source\n(POST /api/sources)\n生成 Token

    src_active --> src_disabled : 停用\n(PUT /api/sources/:id/disable)\nErrSourceAlreadyDisabled(110507)\n若已禁用
    src_disabled --> src_active : 启用\n(PUT /api/sources/:id/enable)\nErrSourceAlreadyEnabled(110508)\n若已启用

    src_active --> src_deleted : 删除\n(DELETE /api/sources/:id)\n软删除，Token 失效
    src_disabled --> src_deleted : 删除\n(DELETE /api/sources/:id)\n软删除，Token 失效

    src_deleted --> src_deleted : 不可恢复\nErrSourceAlreadyDeleted(110509)

    note right of src_active
        Token 有效，可接受推送
        POST /api/message/push 可通过
    end note

    note right of src_disabled
        Token 失效，推送被拒
        ErrSourceNotFound(110503)
    end note

    note right of src_deleted
        软删除，不可恢复
        所有操作返回 110509
    end note
}

state "Channel 状态机" as channel_sm {
    state "正常\n(Active)\nstatus = 1" as ch_active
    state "禁用\n(Disabled)\nstatus = 2" as ch_disabled
    state "已删除\n(Deleted)\nstatus = -1" as ch_deleted

    [*] --> ch_active : 创建 Channel\n(POST /api/channels)\n配置渠道凭证

    ch_active --> ch_disabled : 停用\n(PUT /api/channels/:id/disable)\nErrChannelAlreadyDisabled(110607)\n若已禁用
    ch_disabled --> ch_active : 启用\n(PUT /api/channels/:id/enable)\nErrChannelAlreadyEnabled(110608)\n若已启用

    ch_active --> ch_deleted : 删除\n(DELETE /api/channels/:id)\n软删除
    ch_disabled --> ch_deleted : 删除\n(DELETE /api/channels/:id)\n软删除

    ch_deleted --> ch_deleted : 不可恢复\nErrChannelAlreadyDeleted(110609)

    note right of ch_active
        渠道可用，可接收推送
        可执行测试连接
    end note

    note right of ch_disabled
        渠道停用，推送时跳过
        测试连接返回 110607
    end note
}

state "Message 状态机" as message_sm {
    state "待推送\n(Pending)\nstatus = 100" as msg_pending
    state "推送成功\n(Sent)\nstatus = 200" as msg_sent
    state "推送失败\n(Failed)\nstatus = 300" as msg_failed
    state "已删除\n(Deleted)\nstatus = -1" as msg_deleted

    [*] --> msg_pending : 创建消息记录\n(INSERT status=100)\n并发推送启动时

    msg_pending --> msg_sent : Sender.Send() 成功\n(UPDATE status=200)
    msg_pending --> msg_failed : Sender.Send() 失败\n(UPDATE status=300)\n或渠道类型不支持\n或消息记录创建后\nSender 不可用

    msg_failed --> msg_pending : 重试推送\n(UPDATE status=100)\n[预留重试场景]

    msg_sent --> msg_deleted : 删除\n(DELETE /api/messages/:id)\nErrMessageAlreadyDeleted(110705)\n若已删除
    msg_failed --> msg_deleted : 删除
    msg_pending --> msg_deleted : 删除

    msg_deleted --> msg_deleted : 不可恢复\nErrMessageAlreadyDeleted(110705)

    note right of msg_pending
        消息已入库，等待推送
        并发推送时先创建记录
    end note

    note right of msg_failed
        推送失败，记录错误原因
        ErrMessagePushFailed(110702)
        ErrMessageRecordFailed(110704)
        第三方错误(200xxx)
    end note

    note right of msg_sent
        推送成功，渠道已确认
    end note
}

state "RefreshToken 状态机" as rt_sm {
    state "有效\n(Valid)\nrevoked = false" as rt_valid
    state "已撤销\n(Revoked)\nrevoked = true" as rt_revoked
    state "已过期\n(Expired)\nexpires_at < now" as rt_expired

    [*] --> rt_valid : 登录/注册时创建\n(INSERT refresh_tokens)

    rt_valid --> rt_revoked : 刷新令牌时撤销旧令牌\n(UPDATE revoked=true)\n或主动登出
    rt_valid --> rt_expired : 超过 expires_at\n(7天有效期)

    rt_revoked --> [*] : 不可再用\nErrRefreshTokenRevoked(110301)
    rt_expired --> [*] : 不可再用\nErrRefreshTokenExpired(110302)

    note right of rt_valid
        可用于刷新 Access Token
        POST /api/auth/refresh
    end note

    note right of rt_revoked
        已被新令牌替代
        每次刷新撤销旧令牌+创建新令牌
    end note
}

@enduml
