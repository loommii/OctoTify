@startuml OctoTify_Class_Middleware

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60

title OctoTify 类图（2/6）—— 中间件与基础设施

package "pkg/response (统一响应)" {
    class "Response (API统一响应)" as Response <<struct>> {
        + Code: int            ' 业务错误码，0=成功
        + Msg: string          ' 响应消息（支持i18n）
        + Data: interface{}    ' 响应数据
    }
    class "PageResult (分页结果)" as PageResult <<struct>> {
        + List: interface{}    ' 数据列表
        + Total: int64         ' 总条数
        + Page: int            ' 当前页码（从1开始）
        + PageSize: int        ' 每页条数（最大100）
    }
}

package "pkg/errors (错误码)" {
    class "CodeError (业务错误)" as CodeError <<struct>> {
        + Code: int            ' 错误码（如110500）
        + Msg: string          ' 默认语言错误消息
    }
    note right of CodeError
        预定义错误码变量：
        ErrRegisterUsernameExists (110104)
        ErrLoginInvalidCredentials (110200)
        ErrRefreshTokenRevoked (110301)
        ErrSourceNotFound (110503)
        ErrChannelNotFound (110603)
        ErrMessagePushFailed (110702)
        ...
    end note
}

package "pkg/jwt (JWT工具)" {
    class "JWTHelper (JWT助手)" as JWTHelper <<struct>> {
        - secret: string            ' JWT签名密钥
        - accessTTL: time.Duration  ' Access Token有效期（1小时）
        - refreshTTL: time.Duration ' Refresh Token有效期（7天）
    }
    class "TokenPair (令牌对)" as TokenPair <<struct>> {
        + AccessToken: string   ' 访问令牌
        + RefreshToken: string  ' 刷新令牌
    }
    class "Claims (JWT声明)" as Claims <<struct>> {
        + UserID: int64                ' 用户ID
        + Username: string             ' 用户名
        + JTI: string                  ' 令牌唯一标识
        + RegisteredClaims: jwt.RegisteredClaims ' JWT标准声明
    }
    JWTHelper ..> TokenPair : 生成
    JWTHelper ..> Claims : 解析
}

package "pkg/i18n (多语言)" {
    class "I18n (国际化)" as I18n <<struct>> {
        - defaultLang: string                     ' 默认语言（zh-CN）
        - translations: map[string]map[int]string  ' 翻译映射（语言→错误码→消息）
        + Translate(lang string, code int): string  ' 根据语言和错误码返回翻译消息
    }
}

package "internal/middleware (中间件)" {
    class "RequestIDMiddleware (请求ID中间件)" as RequestIDMiddleware <<struct>> {
        + Execute(): gin.HandlerFunc ' 生成/透传UUID v7请求ID
    }
    class "LoggingMiddleware (日志中间件)" as LoggingMiddleware <<struct>> {
        - logger: *zap.Logger        ' zap日志实例
        + Execute(): gin.HandlerFunc ' 记录请求入口/出口日志
    }
    class "AuthMiddleware (JWT鉴权中间件)" as AuthMiddleware <<struct>> {
        - jwtHelper: *JWTHelper      ' JWT助手
        + Execute(): gin.HandlerFunc ' 验证Access Token
    }
    class "I18nMiddleware (多语言中间件)" as I18nMiddleware <<struct>> {
        - i18n: *I18n                ' 国际化实例
        + Execute(): gin.HandlerFunc ' 解析Accept-Language注入上下文
    }
    class "SourceTokenMiddleware (Source Token中间件)" as SourceTokenMiddleware <<struct>> {
        - sourceRepo: SourceRepository ' 来源仓储
        + Execute(): gin.HandlerFunc   ' 验证src前缀的Source Token
    }
}

note as MiddlewareNote
    所有 Middleware 通过 gin.Context 注入：
    - c.Set("request_id", rid)
    - c.Set("user_id", userId)
    - c.Set("accept_language", lang)
    context.Context 贯穿全链路

    中间件注册顺序（由外到内）：
    1. RequestIDMiddleware  — 最外层，确保所有请求有 ID
    2. LoggingMiddleware   — 记录入口/出口日志
    3. I18nMiddleware      — 解析 Accept-Language
    4. AuthMiddleware      — JWT 鉴权（管理后台路由）
       SourceTokenMiddleware — Source Token 鉴权（推送路由）
end note

@enduml
