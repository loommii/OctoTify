@startuml OctoTify_Class_Repository

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60

title OctoTify 类图（5/6）—— Repository 接口层

package "internal/repository (数据访问层)" {

    interface "UserRepository (用户仓储)" as UserRepository <<interface>> {
        + Create(ctx context.Context, user *User) error ' 创建用户
        + FindByUsername(ctx context.Context, username string) (*User, error) ' 根据用户名查询
        + FindByID(ctx context.Context, id int64) (*User, error) ' 根据ID查询
    }

    interface "SourceRepository (消息来源仓储)" as SourceRepository <<interface>> {
        + Create(ctx context.Context, source *Source) (int64, error) ' 创建来源，返回ID
        + Update(ctx context.Context, source *Source) error ' 更新来源
        + FindByID(ctx context.Context, id int64, userId int64) (*Source, error) ' 根据ID和用户ID查询
        + FindByToken(ctx context.Context, token string) (*Source, error) ' 根据Token查询（仅status=1）
        + List(ctx context.Context, userId int64, page int, pageSize int) ([]*Source, int64, error) ' 分页查询来源列表
        + UpdateStatus(ctx context.Context, id int64, userId int64, status int) error ' 更新来源状态
        + Delete(ctx context.Context, id int64, userId int64) error ' 软删除来源
    }

    interface "ChannelRepository (推送渠道仓储)" as ChannelRepository <<interface>> {
        + Create(ctx context.Context, channel *Channel) (int64, error) ' 创建渠道，返回ID
        + Update(ctx context.Context, channel *Channel) error ' 更新渠道
        + FindByID(ctx context.Context, id int64, userId int64) (*Channel, error) ' 根据ID和用户ID查询
        + List(ctx context.Context, userId int64, page int, pageSize int) ([]*Channel, int64, error) ' 分页查询渠道列表
        + FindBySourceID(ctx context.Context, sourceId int64) ([]*Channel, error) ' 根据来源ID查询关联渠道（仅status=1）
        + UpdateStatus(ctx context.Context, id int64, userId int64, status int) error ' 更新渠道状态
        + Delete(ctx context.Context, id int64, userId int64) error ' 软删除渠道
    }

    interface "MessageRepository (消息仓储)" as MessageRepository <<interface>> {
        + Insert(ctx context.Context, msg *Message) (int64, error) ' 插入消息记录，返回ID
        + UpdateStatus(ctx context.Context, id int64, status int) error ' 更新推送状态
        + FindByID(ctx context.Context, id int64, userId int64) (*Message, error) ' 根据ID和用户ID查询
        + List(ctx context.Context, userId int64, page int, pageSize int) ([]*Message, int64, error) ' 分页查询消息列表
        + Filter(ctx context.Context, userId int64, filter *MessageFilter) ([]*Message, int64, error) ' 按条件筛选消息
        + Delete(ctx context.Context, id int64, userId int64) error ' 软删除消息
    }

    interface "RefreshTokenRepository (刷新令牌仓储)" as RefreshTokenRepository <<interface>> {
        + Create(ctx context.Context, token *RefreshToken) error ' 创建刷新令牌记录
        + FindByJTI(ctx context.Context, jti string) (*RefreshToken, error) ' 根据JTI查询令牌
        + Revoke(ctx context.Context, jti string) error ' 撤销令牌（设置revoked=true）
    }

    interface "SourceChannelRepository (来源-渠道关联仓储)" as SourceChannelRepository <<interface>> {
        + DeleteBySourceID(ctx context.Context, sourceId int64) error ' 删除来源的所有渠道绑定
        + BatchCreate(ctx context.Context, items []*SourceChannel) error ' 批量创建渠道绑定
        + FindChannelIDsBySourceID(ctx context.Context, sourceId int64) ([]int64, error) ' 查询来源关联的渠道ID列表
    }
}

note as RepoNote
    Repository 层设计原则：
    1. 所有方法首参为 ctx context.Context
    2. 通过 GORM Gen 生成类型安全查询
    3. 写操作使用事务保护（BEGIN / COMMIT / ROLLBACK）
    4. 软删除：UpdateStatus(status=-1) 或 Delete
    5. FindByToken 仅返回 status=1 的有效 Source
end note

@enduml
