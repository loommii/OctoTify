vars: {
  layout: elk
}

direction: right

style: {
  font-size: 13
}

classes: {
  model: {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
  }
  service: {
    style.fill: "#e3f2fd"
    style.stroke: "#1565c0"
  }
  handler: {
    style.fill: "#fff3e0"
    style.stroke: "#e65100"
  }
  dto: {
    style.fill: "#f3e5f5"
    style.stroke: "#7b1fa2"
  }
  pkg: {
    style.fill: "#e0f2f1"
    style.stroke: "#00695c"
  }
  external: {
    style.fill: "#f5f5f5"
    style.stroke: "#9e9e9e"
    style.stroke-dash: 4
  }
}

"Message" {
  shape: class
  class: model
  +ID: int64
  +SourceID: int64
  +ChannelID: int64
  +Title: string
  +Content: string
  +Status: int
  +CreatedAt: time.Time
  +UpdatedAt: time.Time
}

"Source" {
  shape: class
  class: model
  +ID: int64
  +UserID: int64
  +Name: string
  +Token: string
  +Status: int
}

"Channel" {
  shape: class
  class: model
  +ID: int64
  +UserID: int64
  +Type: string
  +Name: string
  +Status: int
}

"MessageService" {
  shape: class
  class: service
  -db: "*gorm.DB"
  -logger: "*zap.Logger"
  -senderFactory: "*SenderFactory"
  "ListMessages(ctx, userID int64, pageReq *PageReq)": "([]*MessageDTO, int64, error)"
  "FilterMessages(ctx, userID int64, filter *MessageFilterReq)": "([]*MessageDTO, int64, error)"
  +GetMessageByID(ctx, userID, messageID int64): (*MessageDetailDTO, error)
  +DeleteMessage(ctx, userID, messageID int64): error
  -updateMessageStatus(ctx, messageID int64, status int)
}

"MessageHandler" {
  shape: class
  class: handler
  -messageService: "*MessageService"
  +ListMessages(c *gin.Context)
  +FilterMessages(c *gin.Context)
  +GetMessageDetail(c *gin.Context)
  +DeleteMessage(c *gin.Context)
}

"AppError" {
  shape: class
  class: pkg
  +Code: int
  +Msg: string
  +WithInternal(err error): "*AppError"
}

"Response" {
  shape: class
  class: pkg
  +Success(c *gin.Context, data any)
  +SuccessWithPage(c, list, total, page, pageSize)
  +Fail(c *gin.Context, code int, msg string)
  +HandleValidationError(c *gin.Context, err error)
}

"PageResult" {
  shape: class
  class: pkg
  +List: any
  +Total: int64
  +Page: int
  +PageSize: int
}

"FieldError" {
  shape: class
  class: pkg
  +Field: string
  +Message: string
}

"MessageDTO" {
  shape: class
  class: dto
  +ID: int64
  +SourceID: int64
  +ChannelID: int64
  +Title: string
  +Content: string
  +Status: int
  +CreatedAt: int64
  +UpdatedAt: int64
}

"MessageDetailDTO" {
  shape: class
  class: dto
  +ID: int64
  +SourceID: int64
  +SourceName: string
  +ChannelID: int64
  +ChannelName: string
  +ChannelType: string
  +Title: string
  +Content: string
  +Status: int
  +CreatedAt: int64
  +UpdatedAt: int64
}

"MessageFilterReq" {
  shape: class
  class: dto
  PageReq
  +SourceID: "*int64"
  +ChannelID: "*int64"
  +Status: "*int"
  +StartDate: "*int64"
  +EndDate: "*int64"
  +Keyword: string
  +Normalize()
}

"PageReq" {
  shape: class
  class: dto
  +Page: int
  +PageSize: int
  +Normalize()
}

"gin.Context" {
  shape: class
  class: external
}

"gorm.DB" {
  shape: class
  class: external
}

"zap.Logger" {
  shape: class
  class: external
}

"SenderFactory" {
  shape: class
  class: external
  +Create(channelType string): (Sender, error)
}

"Sender" {
  shape: class
  class: external
  "<<interface>>": ""
  "Send(ctx, config datatypes.JSON, title, content string)": error
}

"query.Query" {
  shape: class
  class: external
}

"MessageHandler" -> "MessageService": uses
"MessageService" -> "Message": manages
"MessageService" -> "Source": joins
"MessageService" -> "Channel": joins
"MessageService" -> "gorm.DB": uses
"MessageService" -> "query.Query": uses
"MessageService" -> "AppError": returns
"MessageService" -> "SenderFactory": uses
"MessageDetailDTO" -> "MessageDTO": extends
"MessageFilterReq" -> "PageReq": embeds
"Response" -> "PageResult": wraps
"Response" -> "FieldError": returns
