vars: {
  layout: elk
}

direction: right

style: {
  font-size: 13
}

classes: {
  model: {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
  }
  service: {
    style.fill: "#e3f2fd"
    style.stroke: "#1565c0"
  }
  handler: {
    style.fill: "#fff3e0"
    style.stroke: "#e65100"
  }
  dto: {
    style.fill: "#f3e5f5"
    style.stroke: "#7b1fa2"
  }
  middleware: {
    style.fill: "#fce4ec"
    style.stroke: "#c62828"
  }
  pkg: {
    style.fill: "#e0f2f1"
    style.stroke: "#00695c"
  }
  external: {
    style.fill: "#f5f5f5"
    style.stroke: "#9e9e9e"
    style.stroke-dash: 4
  }
}

"Source" {
  shape: class
  class: model
  +ID: int64
  +UserID: int64
  +Name: string
  +Token: string
  +Description: string
  +Status: int
  +CreatedAt: time.Time
  +UpdatedAt: time.Time
  +LastUsedAt: "*time.Time"
}

"SourceChannel" {
  shape: class
  class: model
  +SourceID: int64
  +ChannelID: int64
  +Status: int
  +CreatedAt: time.Time
}

"User" {
  shape: class
  class: model
  +ID: int64
  +Username: string
  +PasswordHash: string
}

"Channel" {
  shape: class
  class: model
  +ID: int64
  +UserID: int64
  +Type: string
  +Name: string
  +Config: datatypes.JSON
  +Status: int
}

"SourceService" {
  shape: class
  class: service
  -db: "*gorm.DB"
  -logger: "*zap.Logger"
  +CreateSource(ctx, userID int64, req *CreateSourceReq): (*SourceDTO, error)
  "ListSources(ctx, userID int64, pageReq *PageReq)": "([]*SourceDTO, int64, error)"
  +UpdateSource(ctx, sourceID, userID int64, req *UpdateSourceReq): error
  +GetSourceDetail(ctx, sourceID, userID int64): (*SourceDetailResponse, error)
  +GetSourceToken(ctx, sourceID, userID int64): string
  +ResetSourceToken(ctx, sourceID, userID int64): string
  +DisableSource(ctx, sourceID, userID int64): error
  +EnableSource(ctx, sourceID, userID int64): error
  +DeleteSource(ctx, sourceID, userID int64): error
  +VerifyPassword(ctx, userID int64, password string): error
}

"SourceHandler" {
  shape: class
  class: handler
  -sourceService: "*SourceService"
  +CreateSource(c *gin.Context)
  +ListSources(c *gin.Context)
  +UpdateSource(c *gin.Context)
  +GetSourceDetail(c *gin.Context)
  +GetSourceToken(c *gin.Context)
  +ResetSourceToken(c *gin.Context)
  +DisableSource(c *gin.Context)
  +EnableSource(c *gin.Context)
  +DeleteSource(c *gin.Context)
}

"StepUpAuth" {
  shape: class
  class: middleware
  +StepUpAuth(verifyFn PasswordVerifyFunc): gin.HandlerFunc
}

"PasswordVerifyFunc" {
  shape: class
  class: pkg
  "type": "func(ctx, userID, password) error"
}

"AppError" {
  shape: class
  class: pkg
  +Code: int
  +Msg: string
  +WithInternal(err error): "*AppError"
}

"Response" {
  shape: class
  class: pkg
  +Success(c *gin.Context, data any)
  +SuccessWithPage(c, list, total, page, pageSize)
  +Fail(c *gin.Context, code int, msg string)
}

"SourceBaseReq" {
  shape: class
  class: dto
  +Name: string
  +Description: string
}

"CreateSourceReq" {
  shape: class
  class: dto
  SourceBaseReq
  "ChannelIDs": "[]int64"
}

"UpdateSourceReq" {
  shape: class
  class: dto
  SourceBaseReq
  "ChannelIDs": "[]int64"
}

"SourceDTO" {
  shape: class
  class: dto
  +ID: int64
  +Name: string
  +Token: string
  +Description: string
  +Status: int
  +CreatedAt: int64
}

"SourceDetailDTO" {
  shape: class
  class: dto
  +ID: int64
  +Name: string
  +Token: string
  +Description: string
  +Status: int
  +CreatedAt: int64
  +UpdatedAt: int64
  +LastUsedAt: int64
}

"SourceDetailResponse" {
  shape: class
  class: dto
  +Source: "*SourceDetailDTO"
  "Channels": "[]*ChannelDTO"
}

"SourceTokenResponse" {
  shape: class
  class: dto
  +Token: string
}

"VerifyPasswordReq" {
  shape: class
  class: dto
  +Password: string
}

"PageReq" {
  shape: class
  class: dto
  +Page: int
  +PageSize: int
  +Normalize()
}

"ChannelDTO" {
  shape: class
  class: dto
  +ID: int64
  +Type: string
  +Name: string
  +Config: ChannelConfig
  +Status: int
  +CreatedAt: int64
}

"ChannelConfig" {
  shape: class
  class: dto
  "type": "map[string]any"
  +Scan(value any): error
  +Value(): (driver.Value, error)
  +ToJSON(): datatypes.JSON
}

"gin.Context" {
  shape: class
  class: external
}

"gorm.DB" {
  shape: class
  class: external
}

"zap.Logger" {
  shape: class
  class: external
}

"gin.HandlerFunc" {
  shape: class
  class: external
}

"query.Query" {
  shape: class
  class: external
}

"bcrypt" {
  shape: class
  class: external
  "CompareHashAndPassword(hash, password []byte)": error
  "GenerateFromPassword(password []byte, cost int)": "([]byte, error)"
}

"SourceHandler" -> "SourceService": uses
"SourceService" -> "Source": manages
"SourceService" -> "SourceChannel": manages
"SourceService" -> "User": verifies
"SourceService" -> "Channel": queries
"SourceService" -> "gorm.DB": uses
"SourceService" -> "bcrypt": hashes
"SourceService" -> "AppError": returns
"StepUpAuth" -> "PasswordVerifyFunc": invokes
"StepUpAuth" -> "SourceService": calls VerifyPassword
"SourceDetailResponse" -> "SourceDetailDTO": contains
"SourceDetailResponse" -> "ChannelDTO": contains
"CreateSourceReq" -> "SourceBaseReq": embeds
"UpdateSourceReq" -> "SourceBaseReq": embeds
"ChannelDTO" -> "ChannelConfig": uses
"SourceChannel" -> "Source": references
"SourceChannel" -> "Channel": references
