@startuml OctoTify_UseCase

skinparam usecaseStyle uml2
skinparam linetype ortho

title OctoTify 消息总线 - 用例图

left to right direction

actor "用户" as User
actor "外部系统" as External

rectangle "OctoTify 消息总线" {

  package "用户模块" {
    usecase "注册账户" as UC_Register
    usecase "登录" as UC_Login
    usecase "刷新令牌" as UC_RefreshToken
    usecase "修改密码" as UC_ChangePassword
    usecase "查询用户信息" as UC_GetUserProfile
    usecase "退出登录" as UC_Logout
  }

  package "消息来源模块" {
    usecase "创建消息来源" as UC_CreateSource
    usecase "编辑消息来源" as UC_EditSource
    usecase "查看消息来源列表" as UC_ListSources
    usecase "查看来源详情" as UC_ViewSourceDetail
    usecase "查看来源令牌" as UC_ViewSourceToken
    usecase "重置来源令牌" as UC_ResetSourceToken
    usecase "停用消息来源" as UC_DisableSource
    usecase "启用消息来源" as UC_EnableSource
    usecase "删除消息来源" as UC_DeleteSource
  }

  package "推送渠道模块" {
    usecase "创建推送渠道" as UC_CreateChannel
    usecase "编辑推送渠道" as UC_EditChannel
    usecase "查看推送渠道列表" as UC_ListChannels
    usecase "查看渠道详情" as UC_ViewChannelDetail
    usecase "测试渠道连接" as UC_TestChannel
    usecase "停用推送渠道" as UC_DisableChannel
    usecase "启用推送渠道" as UC_EnableChannel
    usecase "删除推送渠道" as UC_DeleteChannel
  }

  package "消息记录模块" {
    usecase "查看消息记录列表" as UC_ListMessages
    usecase "筛选消息记录" as UC_FilterMessages
    usecase "查看消息详情" as UC_ViewMessageDetail
    usecase "删除消息记录" as UC_DeleteMessage
  }

  package "消息推送模块" {
    usecase "推送消息" as UC_PushMessage
    usecase "并发推送到多个渠道" as UC_PushMultiChannels
    usecase "记录推送状态" as UC_RecordStatus
  }
}

User --> UC_Register
User --> UC_Login
User --> UC_RefreshToken
User --> UC_ChangePassword
User --> UC_GetUserProfile
User --> UC_Logout

User --> UC_CreateSource
User --> UC_EditSource
User --> UC_ListSources
User --> UC_ViewSourceDetail
User --> UC_ViewSourceToken
User --> UC_ResetSourceToken
User --> UC_DisableSource
User --> UC_EnableSource
User --> UC_DeleteSource

User --> UC_CreateChannel
User --> UC_EditChannel
User --> UC_ListChannels
User --> UC_ViewChannelDetail
User --> UC_TestChannel
User --> UC_DisableChannel
User --> UC_EnableChannel
User --> UC_DeleteChannel

User --> UC_ListMessages
User --> UC_ViewMessageDetail
User --> UC_DeleteMessage

UC_FilterMessages ..> UC_ListMessages : <<extend>>

External --> UC_PushMessage

UC_PushMessage ..> UC_PushMultiChannels : <<include>>
UC_PushMultiChannels ..> UC_RecordStatus : <<include>>

note right of UC_CreateSource
  创建后获得 Source Token
  用于外部系统推送消息
end note

note right of UC_CreateChannel
  选择渠道类型：
  微信 / Telegram / 钉钉 / 邮件 / Webhook
  并配置对应凭证
end note

note right of UC_EditSource
  编辑来源基本信息
  管理绑定的渠道（勾选/取消）
end note

note right of UC_TestChannel
  发送测试消息到渠道
  验证渠道配置是否正确
end note

note right of UC_PushMessage
  外部系统携带 Source Token
  平台自动推送到所有关联的 Channel
end note

note right of UC_PushMultiChannels
  并发推送到各渠道
  微信 / Telegram / 钉钉 / 邮件 / Webhook
end note

note right of UC_FilterMessages
  筛选条件：
  - 消息来源（Source）
  - 推送渠道（Channel）
  - 推送状态（成功/失败/待推送）
  - 时间范围
  - 关键词（标题/内容）
end note

@enduml
