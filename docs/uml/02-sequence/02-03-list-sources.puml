@startuml OctoTify_Sequence_ListSources

skinparam sequenceStyle svg
skinparam linetype ortho

title 查看消息来源列表 (GET /api/sources)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth 中间件" as JWT
participant "SourceHandler" as Handler
participant "SourceService" as Service
participant "SourceRepository" as Repo
database "SQLite" as DB

User -> Frontend: 访问消息来源页面
Frontend -> Server: GET /api/sources?page=1&pageSize=20
note right: Header: Authorization Bearer {accessToken}\nX-Request-ID: {request_id}
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
    JWT --> Server: {code: 100001, msg: "未提供认证令牌"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "未提供认证令牌"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)\n刷新成功后重试原请求
else 令牌无效或已过期
    JWT --> Server: {code: 100001, msg: "认证令牌无效或已过期"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "认证令牌无效或已过期"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)\n刷新成功后重试原请求
else 令牌有效
    JWT --> Server: userId (从 claims 中提取)
    deactivate JWT
    Server -> Handler: ListSources(userId, pageReq)
    activate Handler
    Handler -> Service: ListSources(ctx, userId, pageReq)
    activate Service

    == 查询列表 ==

    Service -> Repo: List(ctx, userId, page, pageSize)
    activate Repo

    alt 查询失败
        Repo -> DB: SELECT * FROM sources WHERE user_id = ? AND status != -1 ORDER BY created_at DESC LIMIT ? OFFSET ?
        activate DB
        DB --> Repo: 查询错误
        deactivate DB
        Repo --> Service: error
        deactivate Repo
        Service --> Handler: ErrSourceQueryFailed (110505)
        Handler --> Server: {code: 110505, msg: "查询来源失败"}
        note right: 日志：查询来源列表失败\nerror_code=110505, request_id={request_id}, userId={userId}
        Server --> Frontend: {code: 110505, msg: "查询来源失败"}
        Frontend --> User: 显示错误提示
    else 查询成功
        Repo -> DB: SELECT * FROM sources WHERE user_id = ? AND status != -1 ORDER BY created_at DESC LIMIT ? OFFSET ?
        activate DB
        DB --> Repo: sources[]
        deactivate DB
        Repo -> DB: SELECT COUNT(*) FROM sources WHERE user_id = ? AND status != -1
        activate DB
        DB --> Repo: total
        deactivate DB
        Repo --> Service: {list, total}
        deactivate Repo
        Service --> Handler: {list, total, page, pageSize}
        deactivate Service
        Handler --> Server: {code: 0, msg: "请求成功", data: {list, total, page, pageSize}}
        note right: 日志：查询来源列表成功\nrequest_id={request_id}, userId={userId}, total={total}
        deactivate Handler
        Server --> Frontend: {code: 0, msg: "请求成功", data: {list, total, page, pageSize}}
        deactivate Server
        Frontend --> User: 显示来源列表
    end
end

@enduml