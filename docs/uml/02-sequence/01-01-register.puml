@startuml OctoTify_Sequence_Register

skinparam sequenceStyle svg
skinparam linetype ortho

title 注册账户 (POST /api/auth/register)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "AuthHandler" as Handler
participant "AuthService" as Auth
participant "JWT Helper" as JWT
database "SQLite" as DB

User -> Frontend: 输入用户名、密码
Frontend -> Server: POST /api/auth/register {username, password}
activate Server
Server -> Handler: register(req)
activate Handler

== 参数校验 ==

alt 参数校验失败
    Handler -> Handler: 参数校验（用户名长度、密码强度）
    Handler --> Server: {code: 110100~110103, msg: "错误信息"}
    Server --> Frontend: {code: 110100~110103, msg: "错误信息"}
    Frontend --> User: 显示错误提示
else 参数校验通过
    Handler -> Handler: 参数校验通过
    Handler -> Auth: register(username, password)
    activate Auth

    == 用户名检查 ==

    alt 用户名已存在
        Auth -> DB: SELECT * FROM users WHERE username = ?
        activate DB
        DB --> Auth: user（用户名已存在）
        deactivate DB
        Auth --> Handler: ErrRegisterUsernameExists (110104)
        Handler --> Server: {code: 110104, msg: "用户名已存在"}
        Server --> Frontend: {code: 110104, msg: "用户名已存在"}
        Frontend --> User: 显示错误提示
    else 用户名可用
        Auth -> DB: SELECT * FROM users WHERE username = ?
        activate DB
        DB --> Auth: nil（用户名不存在）
        deactivate DB

        == 创建用户 ==

        Auth -> Auth: 密码哈希

        alt 数据库插入失败
            Auth -> DB: INSERT INTO users
            activate DB
            DB --> Auth: 插入失败
            deactivate DB
            Auth --> Handler: ErrRegisterFailed (110105)
            Handler --> Server: {code: 110105, msg: "注册失败"}
            Server --> Frontend: {code: 110105, msg: "注册失败"}
            Frontend --> User: 显示错误提示
        else 数据库插入成功
            Auth -> DB: INSERT INTO users
            activate DB
            DB --> Auth: userId
            deactivate DB

            == 生成令牌 ==

            Auth -> JWT: generateAccessToken(claims)
            activate JWT
            JWT --> Auth: accessToken
            deactivate JWT
            Auth -> JWT: generateRefreshToken(claims)
            activate JWT
            JWT --> Auth: refreshToken
            deactivate JWT

            alt 刷新令牌记录失败
                Auth -> DB: INSERT INTO refresh_tokens
                activate DB
                DB --> Auth: 插入失败
                deactivate DB
                Auth --> Handler: ErrRefreshTokenFailed (110303)
                Handler --> Server: {code: 110303, msg: "刷新令牌失败"}
                Server --> Frontend: {code: 110303, msg: "刷新令牌失败"}
                Frontend --> User: 显示错误提示
            else 刷新令牌记录成功
                Auth -> DB: INSERT INTO refresh_tokens
                activate DB
                DB --> Auth: 成功
                deactivate DB
                Auth --> Handler: TokenPair {accessToken, refreshToken}
                deactivate Auth
                Handler --> Server: {code: 0, data: {token, refreshToken, user}}
                deactivate Handler
                Server --> Frontend: {code: 0, data: {token, refreshToken, user}}
                deactivate Server
                Frontend --> User: 注册成功，自动登录，跳转首页
            end
        end
    end
end

@enduml
