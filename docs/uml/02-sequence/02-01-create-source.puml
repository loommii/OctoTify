@startuml OctoTify_Sequence_CreateSource

skinparam sequenceStyle svg
skinparam linetype ortho

title 创建消息来源 (POST /api/sources)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "SourceHandler" as Handler
participant "SourceService" as Service
database "SQLite" as DB

User -> Frontend: 输入名称、描述
Frontend -> Server: POST /api/sources {name, description}
note right: Header: Authorization Bearer {accessToken}
activate Server
Server -> Handler: createSource(userId, req)
activate Handler

== 参数校验 ==

alt 名称为空
    Handler -> Handler: 参数校验
    Handler --> Server: ErrSourceParamNameEmpty (110500)
    Server --> Frontend: {code: 110500, msg: "来源名称不能为空"}
    Frontend --> User: 显示错误提示
else 参数校验通过
    Handler -> Handler: 参数校验通过
    Handler -> Service: createSource(userId, name, description)
    activate Service

    == 创建来源（事务） ==

    note over Service, DB: BEGIN TRANSACTION

    Service -> Service: 生成 Token（前缀 src + UUIDv4 无连字符）
    Service -> DB: SELECT COUNT(*) FROM sources WHERE token = ?
    activate DB
    DB --> Service: 0（Token 唯一）
    deactivate DB

    alt 数据库插入失败
        Service -> DB: INSERT INTO sources (user_id, name, description, token, status)
        activate DB
        DB --> Service: 插入失败
        deactivate DB
        note over Service, DB: ROLLBACK
        Service --> Handler: ErrSourceInsertFailed (110501)
        Handler --> Server: {code: 110501, msg: "创建来源失败"}
        Server --> Frontend: {code: 110501, msg: "创建来源失败"}
        Frontend --> User: 显示错误提示
    else 数据库插入成功
        Service -> DB: INSERT INTO sources (user_id, name, description, token, status)
        activate DB
        DB --> Service: sourceId
        deactivate DB
        note over Service, DB: COMMIT
        Service --> Handler: source
        deactivate Service
        Handler --> Server: {code: 0, data: source}
        deactivate Handler
        Server --> Frontend: {code: 0, data: source}
        deactivate Server
        Frontend --> User: 创建成功
    end
end

@enduml