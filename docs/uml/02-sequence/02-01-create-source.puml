@startuml OctoTify_Sequence_CreateSource

skinparam sequenceStyle svg
skinparam linetype ortho

title 创建消息来源 (POST /api/sources)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth 中间件" as JWT
participant "SourceHandler" as Handler
participant "SourceService" as Service
database "SQLite" as DB

User -> Frontend: 输入名称、描述、选择渠道
Frontend -> Server: POST /api/sources {name, description, channel_ids}
note right: Header: Authorization Bearer {accessToken}\nX-Request-ID: {request_id}
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
    JWT --> Server: {code: 100001, msg: "未提供认证令牌"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "未提供认证令牌"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌无效或已过期
    JWT --> Server: {code: 100001, msg: "认证令牌无效或已过期"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "认证令牌无效或已过期"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌有效
    JWT --> Server: userId (从 claims 中提取)
    deactivate JWT
    Server -> Handler: createSource(userId, req)
    activate Handler

    == 参数校验（gin binding + 自定义 validator） ==

    alt 参数校验失败
        Handler --> Server: {code: 110500, msg: "来源名称不能为空"}
        Server --> Frontend: {code: 110500, msg: "来源名称不能为空"}
        Frontend --> User: 显示错误提示
    else 参数校验通过
        Handler -> Service: createSource(userId, name, description, channel_ids)
        activate Service

        == 生成 Token ==

        Service -> Service: 生成 Token（前缀 src + UUIDv7 无连字符，共 35 位）
        Service -> DB: SELECT COUNT(*) FROM sources WHERE token = ?
        activate DB
        DB --> Service: 0（Token 唯一）
        deactivate DB

        == 创建来源并绑定渠道（事务） ==

        alt 创建失败
            Service -> DB: BEGIN TRANSACTION
            activate DB
            Service -> DB: INSERT INTO sources (user_id, name, description, token, status)
            DB --> Service: 插入失败
            Service -> DB: ROLLBACK
            deactivate DB
            Service --> Handler: ErrSourceInsertFailed (110501)
            Handler --> Server: {code: 110501, msg: "创建来源失败"}
            note right: 日志：创建来源失败\nerror_code=110501, request_id={request_id}
            Server --> Frontend: {code: 110501, msg: "创建来源失败"}
            Frontend --> User: 显示错误提示
        else 创建成功
            Service -> DB: BEGIN TRANSACTION
            activate DB
            Service -> DB: INSERT INTO sources (user_id, name, description, token, status)
            DB --> Service: sourceId
            alt 绑定渠道
                Service -> DB: INSERT INTO source_channels (source_id, channel_id, status) VALUES ...
                DB --> Service: 批量插入成功
            end
            Service -> DB: COMMIT
            deactivate DB
            note right: 日志：来源创建成功\nsourceId=1, name=xxx, channel_count=N, request_id={request_id}
            Service --> Handler: {id, user_id, name, token, description, status, created_at}
            deactivate Service
            Handler --> Server: {code: 0, data: {id, user_id, name, token, description, status, created_at}}
            deactivate Handler
            Server --> Frontend: {code: 0, data: {id, user_id, name, token, description, status, created_at}}
            deactivate Server
            Frontend --> User: 创建成功，显示 Source Token
        end
    end
end

@enduml
