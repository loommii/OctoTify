@startuml OctoTify_Sequence_PushMessage

skinparam sequenceStyle svg
skinparam linetype ortho

title 推送消息 (POST /api/message/push)

actor "外部系统" as External
participant "HTTPServer" as Server
participant "PushHandler" as Handler
participant "MessageService" as Service
database "SQLite" as DB

External -> Server: POST /api/message/push {title, message}
note right: Header: Authorization Bearer {sourceToken}
activate Server
Server -> Handler: pushMessage(sourceToken, req)
activate Handler

== 参数校验 ==

Handler -> Handler: ShouldBindJSON(req)
note over Handler: 校验 title 和 message 不能为空

alt 消息标题为空
    Handler --> Server: ErrMessageParamTitleEmpty (110700)
    Server --> External: {code: 110700, msg: "消息标题不能为空"}
else 消息内容为空
    Handler --> Server: ErrMessageParamContentEmpty (110701)
    Server --> External: {code: 110701, msg: "消息内容不能为空"}
else 参数校验通过
    Handler -> Handler: 参数校验通过

    == 验证来源 ==

    Handler -> Service: PushMessage(ctx, sourceToken, req)
    activate Service
    Service -> DB: SELECT * FROM sources WHERE token = ? AND status = 1
    activate DB

    alt 数据库查询失败
        DB --> Service: 查询错误
        deactivate DB
        Service --> Handler: ErrSourceQueryFailed (110505)
        Handler --> Server: {code: 110505, msg: "查询来源失败"}
        Server --> External: {code: 110505, msg: "查询来源失败"}
    else Source 不存在或已禁用
        DB --> Service: nil
        deactivate DB
        Service --> Handler: ErrSourceNotFound (110503)
        Handler --> Server: {code: 110503, msg: "来源不存在或已禁用"}
        Server --> External: {code: 110503, msg: "来源不存在或已禁用"}
    else Source 有效
        DB --> Service: source
        deactivate DB

        == 查询渠道 ==

        Service -> DB: SELECT c.* FROM channels c INNER JOIN source_channels sc ON c.id = sc.channel_id WHERE sc.source_id = ? AND c.status = 1
        activate DB

        alt 数据库查询失败
            DB --> Service: 查询错误
            deactivate DB
            Service --> Handler: ErrChannelQueryFailed (110605)
            Handler --> Server: {code: 110605, msg: "查询渠道失败"}
            Server --> External: {code: 110605, msg: "查询渠道失败"}
        else 无可用渠道
            DB --> Service: channels[] (empty)
            deactivate DB
            Service --> Handler: ErrMessageNoChannels (110703)
            Handler --> Server: {code: 110703, msg: "来源未绑定任何渠道"}
            Server --> External: {code: 110703, msg: "来源未绑定任何渠道"}
        else 有可用渠道
            DB --> Service: channels[]
            deactivate DB

            == 并发推送 ==

            Service -> Service: pushToChannels(source, channels, req)
            note over Service: 使用 errgroup 并发推送\n每个渠道独立 goroutine\n单个渠道超时 30 秒

            par 渠道 1 推送
                Service -> DB: BEGIN TRANSACTION
                activate DB
                Service -> DB: INSERT INTO messages (source_id, channel_id, title, content, status, created_at, updated_at) VALUES (?, ?, ?, ?, 100, ?, ?)
                DB --> Service: messageId
                Service -> DB: COMMIT
                deactivate DB
                Service -> Service: senderFactory.Create(channel.type)
                Service -> Service: context.WithTimeout(ctx, 30s)
                Service -> Service: sender.Send(ctx, config, title, message)
                alt 推送成功
                    Service -> DB: BEGIN TRANSACTION
                    activate DB
                    Service -> DB: UPDATE messages SET status = 200, updated_at = ? WHERE id = ?
                    DB --> Service: 成功
                    Service -> DB: COMMIT
                    deactivate DB
                else 推送失败
                    Service -> DB: BEGIN TRANSACTION
                    activate DB
                    Service -> DB: UPDATE messages SET status = 300, updated_at = ? WHERE id = ?
                    DB --> Service: 成功
                    Service -> DB: COMMIT
                    deactivate DB
                end
            else 渠道 2 推送
                Service -> DB: BEGIN TRANSACTION
                activate DB
                Service -> DB: INSERT INTO messages (source_id, channel_id, title, content, status, created_at, updated_at) VALUES (?, ?, ?, ?, 100, ?, ?)
                DB --> Service: messageId
                Service -> DB: COMMIT
                deactivate DB
                Service -> Service: senderFactory.Create(channel.type)
                Service -> Service: context.WithTimeout(ctx, 30s)
                Service -> Service: sender.Send(ctx, config, title, message)
                alt 推送成功
                    Service -> DB: BEGIN TRANSACTION
                    activate DB
                    Service -> DB: UPDATE messages SET status = 200, updated_at = ? WHERE id = ?
                    DB --> Service: 成功
                    Service -> DB: COMMIT
                    deactivate DB
                else 推送失败
                    Service -> DB: BEGIN TRANSACTION
                    activate DB
                    Service -> DB: UPDATE messages SET status = 300, updated_at = ? WHERE id = ?
                    DB --> Service: 成功
                    Service -> DB: COMMIT
                    deactivate DB
                end
            end

            Service -> Service: 汇总推送结果 (成功数/失败数)
            Service -> Service: 记录推送完成日志
            Service --> Handler: PushResponse{total, success, failed, results}
            deactivate Service
            Handler --> Server: {code: 0, msg: "请求成功", data: results}
            Server --> External: {code: 0, msg: "请求成功", data: results}
        end
    end
end
deactivate Handler
deactivate Server

@enduml
