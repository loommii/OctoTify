vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
jwt: JWTAuth 中间件
handler: ChannelHandler
service: ChannelService
db: SQLite

user -> frontend.a: "点击某个渠道"
frontend.a -> server.a: "GET /api/channels/:id"
server.a -> jwt.a: "JWTAuth(accessToken)"

未提供认证令牌: {
  jwt.a --> server.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口" {
    class: error
  }
}

令牌无效或已过期: {
  jwt.a --> server.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口" {
    class: error
  }
}

令牌有效: {
  jwt.a --> server.a: "userId (从 claims 中提取)"
  server.a -> handler.a: "getChannelDetail(userId, channelId)"
  
  handler.a -> service.a: "getChannelById(channelId, userId)"
  service.a -> db.a: "SELECT * FROM channels WHERE id = ? AND user_id = ?"
  
  渠道不存在: {
    db.a --> service.a: "nil"
    service.a --> handler.a: "ErrChannelNotFound (110603)" {
      class: error
    }
    handler.a --> server.a: "{code: 110603, msg: 渠道不存在}" {
      class: error
    }
    server.a --> frontend.a: "{code: 110603, msg: 渠道不存在}" {
      class: error
    }
    frontend.a --> user: "显示错误提示" {
      class: error
    }
  }
  
  渠道已删除: {
    db.a --> service.a: "channel (status = -1)"
    service.a --> handler.a: "ErrChannelAlreadyDeleted (110609)" {
      class: error
    }
    handler.a --> server.a: "{code: 110609, msg: 渠道已删除}" {
      class: error
    }
    server.a --> frontend.a: "{code: 110609, msg: 渠道已删除}" {
      class: error
    }
    frontend.a --> user: "显示错误提示" {
      class: error
    }
  }
  
  渠道存在: {
    db.a --> service.a: "channel"
    service.a --> handler.a: "channel" {
      class: success
    }
    handler.a --> server.a: "{code: 0, data: channel}" {
      class: success
    }
    server.a --> frontend.a: "{code: 0, data: channel}" {
      class: success
    }
    frontend.a --> user: "显示渠道详情" {
      class: success
    }
  }
}
