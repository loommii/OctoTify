@startuml OctoTify_Sequence_EditChannel

skinparam sequenceStyle svg
skinparam linetype ortho

title 编辑推送渠道 (PUT /api/channels/:id)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth 中间件" as JWT
participant "ChannelHandler" as Handler
participant "ChannelService" as Service
database "SQLite" as DB

User -> Frontend: 修改名称、配置
Frontend -> Server: PUT /api/channels/:id {name, config}
note right: Header: Authorization Bearer {accessToken}\nX-Request-ID: {request_id}
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
    JWT --> Server: {code: 100001, msg: "未提供认证令牌"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "未提供认证令牌"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌无效或已过期
    JWT --> Server: {code: 100001, msg: "认证令牌无效或已过期"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "认证令牌无效或已过期"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌有效
    JWT --> Server: userId (从 claims 中提取)
    deactivate JWT
    Server -> Handler: updateChannel(userId, channelId, req)
    activate Handler

    == 查询渠道 ==

    Handler -> Service: getChannelById(channelId, userId)
    activate Service
    Service -> DB: SELECT * FROM channels WHERE id = ? AND user_id = ?
    activate DB

    alt 渠道不存在
        DB --> Service: nil
        deactivate DB
        Service --> Handler: ErrChannelNotFound (110603)
        Handler --> Server: {code: 110603, msg: "渠道不存在"}
        Server --> Frontend: {code: 110603, msg: "渠道不存在"}
        Frontend --> User: 显示错误提示
    else 渠道已删除
        DB --> Service: channel (status = -1)
        deactivate DB
        Service --> Handler: ErrChannelAlreadyDeleted (110609)
        Handler --> Server: {code: 110609, msg: "渠道已删除"}
        Server --> Frontend: {code: 110609, msg: "渠道已删除"}
        Frontend --> User: 显示错误提示
    else 渠道存在
        DB --> Service: channel
        deactivate DB
        Service --> Handler: channel
        deactivate Service

        == 更新渠道 ==

        Handler -> Service: updateChannel(channelId, name, config, userId)
        activate Service

        alt 数据库更新失败
            Service -> DB: UPDATE channels SET name = ?, config = ? WHERE id = ? AND user_id = ?
            activate DB
            DB --> Service: 更新失败
            deactivate DB
            Service --> Handler: ErrChannelQueryFailed (110605)
            Handler --> Server: {code: 110605, msg: "查询渠道失败"}
            Server --> Frontend: {code: 110605, msg: "查询渠道失败"}
            Frontend --> User: 显示错误提示
        else 数据库更新成功
            Service -> DB: UPDATE channels SET name = ?, config = ? WHERE id = ? AND user_id = ?
            activate DB
            DB --> Service: 成功
            deactivate DB
            Service --> Handler: 成功
            deactivate Service
            Handler --> Server: {code: 0}
            deactivate Handler
            Server --> Frontend: {code: 0, msg: "更新成功"}
            deactivate Server
            Frontend --> User: 编辑成功
        end
    end
end

@enduml
