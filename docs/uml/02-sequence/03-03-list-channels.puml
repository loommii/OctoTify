@startuml OctoTify_Sequence_ListChannels

skinparam sequenceStyle svg
skinparam linetype ortho

title 查看推送渠道列表 (GET /api/channels)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth 中间件" as JWT
participant "ChannelHandler" as Handler
participant "ChannelService" as Service
database "SQLite" as DB

User -> Frontend: 访问推送渠道页面
Frontend -> Server: GET /api/channels?page=1&pageSize=20
note right: Header: Authorization Bearer {accessToken}\nX-Request-ID: {request_id}
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
    JWT --> Server: {code: 100001, msg: "未提供认证令牌"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "未提供认证令牌"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌无效或已过期
    JWT --> Server: {code: 100001, msg: "认证令牌无效或已过期"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "认证令牌无效或已过期"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌有效
    JWT --> Server: userId (从 claims 中提取)
    deactivate JWT
    Server -> Handler: listChannels(userId, page, pageSize)
    activate Handler
    Handler -> Service: getChannels(userId, page, pageSize)
    activate Service

    == 查询列表 ==

    Service -> DB: SELECT * FROM channels WHERE user_id = ? AND status != -1 LIMIT ? OFFSET ?
    activate DB

    alt 查询失败
        DB --> Service: 查询错误
        deactivate DB
        Service --> Handler: ErrChannelQueryFailed (110605)
        Handler --> Server: {code: 110605, msg: "查询渠道失败"}
        Server --> Frontend: {code: 110605, msg: "查询渠道失败"}
        Frontend --> User: 显示错误提示
    else 查询成功
        DB --> Service: channels[]
        deactivate DB
        Service -> DB: SELECT COUNT(*) FROM channels WHERE user_id = ? AND status != -1
        activate DB
        DB --> Service: total
        deactivate DB
        Service --> Handler: {list, total}
        deactivate Service
        Handler --> Server: {code: 0, data: {list, total}}
        deactivate Handler
        Server --> Frontend: {code: 0, data: {list, total}}
        deactivate Server
        Frontend --> User: 显示渠道列表
    end
end

@enduml
