@startuml OctoTify_Sequence_ResetSourceToken

skinparam sequenceStyle svg
skinparam linetype ortho

title 重置来源令牌 (PUT /api/sources/:id/token)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth 中间件" as JWT
participant "SourceHandler" as Handler
participant "SourceService" as Service
database "SQLite" as DB

User -> Frontend: 点击重置令牌
Frontend -> Frontend: 弹出密码输入框
Frontend -> User: 要求输入密码验证身份
User -> Frontend: 输入密码
Frontend -> Server: PUT /api/sources/:id/token
note right: Header: Authorization Bearer {accessToken}\nX-Request-ID: {request_id}\nBody: {password}
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
    JWT --> Server: {code: 100001, msg: "未提供认证令牌"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "未提供认证令牌"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌无效或已过期
    JWT --> Server: {code: 100001, msg: "认证令牌无效或已过期"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "认证令牌无效或已过期"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌有效
    JWT --> Server: userId (从 claims 中提取)
    deactivate JWT
    Server -> Handler: resetSourceToken(userId, sourceId, password)
    activate Handler

    == 密码验证 ==

    Handler -> Service: verifyPassword(userId, password)
    activate Service
    Service -> DB: SELECT password_hash FROM users WHERE id = ?
    activate DB

    alt 密码验证失败
        DB --> Service: password_hash
        deactivate DB
        Service -> Service: bcrypt.CompareHashAndPassword
        Service --> Handler: ErrUnauthorized (100001)
        Handler --> Server: {code: 100001, msg: "密码错误"}
        Server --> Frontend: {code: 100001, msg: "密码错误"}
        Frontend --> User: 显示密码错误提示
    else 密码验证成功
        DB --> Service: password_hash
        deactivate DB
        Service -> Service: bcrypt.CompareHashAndPassword
        Service --> Handler: 验证成功
        deactivate Service

        == 查询来源 ==

        Handler -> Service: resetSourceToken(sourceId, userId)
        activate Service
        Service -> DB: SELECT * FROM sources WHERE id = ? AND user_id = ?
        activate DB

        alt 来源不存在
            DB --> Service: nil
            deactivate DB
            Service --> Handler: ErrSourceNotFound (110503)
            Handler --> Server: {code: 110503, msg: "来源不存在"}
            Server --> Frontend: {code: 110503, msg: "来源不存在"}
            Frontend --> User: 显示错误提示
        else 来源已删除
            DB --> Service: source (status = -1)
            deactivate DB
            Service --> Handler: ErrSourceAlreadyDeleted (110509)
            Handler --> Server: {code: 110509, msg: "来源已删除"}
            Server --> Frontend: {code: 110509, msg: "来源已删除"}
            Frontend --> User: 显示错误提示
        else 来源存在
            DB --> Service: source
            deactivate DB

            == 生成新令牌 ==

            Service -> Service: 生成新 Token（前缀 src + UUIDv4 无连字符）
            Service -> DB: SELECT COUNT(*) FROM sources WHERE token = ?
            activate DB
            DB --> Service: 0（Token 唯一）
            deactivate DB

            == 更新令牌 ==

            Service -> DB: UPDATE sources SET token = ?, updated_at = ? WHERE id = ? AND user_id = ?
            activate DB

            alt 数据库更新失败
                DB --> Service: 更新失败
                deactivate DB
                Service --> Handler: ErrSourceTokenFailed (110502)
                Handler --> Server: {code: 110502, msg: "生成来源Token失败"}
                Server --> Frontend: {code: 110502, msg: "生成来源Token失败"}
                Frontend --> User: 显示错误提示
            else 数据库更新成功
                DB --> Service: 成功
                deactivate DB
                Service --> Handler: newToken
                deactivate Service
                Handler --> Server: {code: 0, data: {newToken}}
                deactivate Handler
                Server --> Frontend: {code: 0, data: {newToken}}
                deactivate Server
                Frontend --> User: 显示新令牌
            end
        end
    end
end

@enduml
