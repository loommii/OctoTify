vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
jwt: JWTAuth 中间件
handler: SourceHandler
service: SourceService
db: SQLite

user -> frontend.a: "修改名称、描述、渠道绑定"
frontend.a -> server.a: "PUT /api/sources/:id {name, description, channel_ids}"
server.a -> jwt.a: "JWTAuth(accessToken)"

未提供认证令牌: {
  jwt.a --> server.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口" {
    class: error
  }
}

令牌无效或已过期: {
  jwt.a --> server.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口" {
    class: error
  }
}

令牌有效: {
  jwt.a --> server.a: "userId (从 claims 中提取)"
  server.a -> handler.a: "updateSource(userId, sourceId, req)"
  
  JSON解析失败: {
    handler.a --> server.a: "{code: 100000, msg: 请求参数格式错误}" {
      class: error
    }
    server.a --> frontend.a: "{code: 100000, msg: 请求参数格式错误}" {
      class: error
    }
    frontend.a --> user: "显示错误提示" {
      class: error
    }
  }
  
  JSON解析通过: {
    handler.a -> service.a: "UpdateSource(sourceId, userId, req)"
    service.a -> db.a: "SELECT * FROM sources WHERE id = ? AND user_id = ?"
    
    来源不存在: {
      db.a --> service.a: "nil"
      service.a --> handler.a: "ErrSourceNotFound (110503)" {
        class: error
      }
      handler.a --> server.a: "{code: 110503, msg: 来源不存在}" {
        class: error
      }
      server.a --> frontend.a: "{code: 110503, msg: 来源不存在}" {
        class: error
      }
      frontend.a --> user: "显示错误提示" {
        class: error
      }
    }
    
    来源已删除: {
      db.a --> service.a: "source (status = -1)"
      service.a --> handler.a: "ErrSourceAlreadyDeleted (110509)" {
        class: error
      }
      handler.a --> server.a: "{code: 110509, msg: 来源已删除}" {
        class: error
      }
      server.a --> frontend.a: "{code: 110509, msg: 来源已删除}" {
        class: error
      }
      frontend.a --> user: "显示错误提示" {
        class: error
      }
    }
    
    来源存在且有效: {
      db.a --> service.a: "source (status = 1 或 2)"
      
      handler.a -> service.b: "UpdateSource(sourceId, name, description, channel_ids, userId)"
      service.b -> db.b: "BEGIN TRANSACTION"
      
      更新失败: {
        service.b -> db.b: "UPDATE sources SET name = ?, description = ?, updated_at = ? WHERE id = ? AND user_id = ?"
        db.b --> service.b: "更新失败"
        service.b -> db.b: "ROLLBACK"
        service.b --> handler.b: "ErrSourceUpdateFailed (110510)" {
          class: error
        }
        handler.b --> server.b: "{code: 110510, msg: 更新来源失败}" {
          class: error
        }
        server.b --> frontend.b: "{code: 110510, msg: 更新来源失败}" {
          class: error
        }
        frontend.b --> user: "显示错误提示" {
          class: error
        }
      }
      
      更新成功: {
        service.b -> db.b: "UPDATE sources SET name = ?, description = ?, updated_at = ? WHERE id = ? AND user_id = ?"
        db.b --> service.b: "成功"
        
        需要更新渠道绑定: {
          service.b -> db.b: "DELETE FROM source_channels WHERE source_id = ?"
          db.b --> service.b: "硬删除旧绑定成功"
          service.b -> db.b: "INSERT INTO source_channels (source_id, channel_id, status) VALUES ..."
          db.b --> service.b: "批量插入成功"
        }
        
        service.b -> db.b: "COMMIT"
        service.b --> handler.b: "成功" {
          class: success
        }
        handler.b --> server.b: "{code: 0}" {
          class: success
        }
        server.b --> frontend.b: "{code: 0, msg: 更新成功}" {
          class: success
        }
        frontend.b --> user: "编辑成功" {
          class: success
        }
      }
    }
  }
}

note: "事务说明：Source 更新与 source_channels 重建在同一事务中，先 DELETE 再 INSERT" {
  near: bottom-center
}
