vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
handler: AuthHandler
auth: AuthService
accessJWT: Access JWT Helper
refreshJWT: Refresh JWT Helper
db: SQLite

user -> frontend.a: "输入用户名、密码"
frontend.a -> server.a: "POST /api/auth/login {username, password}"
server.a -> handler.a: "login(req)"

参数校验失败: {
  handler.a --> server.a: "{code: 110200, msg: 用户名或密码错误}" {
    class: error
  }
  server.a --> frontend.a: "{code: 110200, msg: 用户名或密码错误}" {
    class: error
  }
  frontend.a --> user: "显示错误提示" {
    class: error
  }
}

参数校验通过: {
  handler.a -> auth.b: "login(username, password)"

  auth.b -> db.b: "SELECT * FROM users WHERE username = ?"

  用户不存在或密码错误: {
    db.b --> auth.b: "user / nil"
    auth.b --> auth.b: "bcrypt.CompareHashAndPassword 验证失败"
    auth.b --> handler.b: "ErrLoginInvalidCredentials (110200)" {
      class: error
    }
    handler.b --> server.b: "{code: 110200, msg: 用户名或密码错误}" {
      class: error
    }
    server.b --> frontend.b: "{code: 110200, msg: 用户名或密码错误}" {
      class: error
    }
    frontend.b --> user: "显示错误提示" {
      class: error
    }
  }

  验证成功: {
    db.b --> auth.b: "user"
    auth.b -> auth.b: "bcrypt.CompareHashAndPassword 验证成功"

    auth.b -> accessJWT.b: "generateToken(claims {uid, token_type: access})"
    accessJWT.b --> auth.b: "accessToken"
    auth.b -> refreshJWT.b: "generateToken(claims {uid, token_type: refresh, jti})"
    refreshJWT.b --> auth.b: "refreshToken"

    刷新令牌记录失败: {
      auth.b -> db.b: "INSERT INTO refresh_tokens (jti, user_id, revoked)"
      db.b --> auth.b: "插入失败"
      auth.b --> handler.b: "ErrLoginFailed (110201)" {
        class: error
      }
      handler.b --> server.b: "{code: 110201, msg: 登录失败}" {
        class: error
      }
      server.b --> frontend.b: "{code: 110201, msg: 登录失败}" {
        class: error
      }
      frontend.b --> user: "显示错误提示" {
        class: error
      }
    }

    刷新令牌记录成功: {
      auth.b -> db.b: "INSERT INTO refresh_tokens (jti, user_id, revoked)"
      db.b --> auth.b: "成功"
      auth.b --> handler.b: "{accessToken, refreshToken}" {
        class: success
      }
      handler.b --> server.b: "{code: 0, data: {access_token, refresh_token, user}}" {
        class: success
      }
      server.b --> frontend.b: "{code: 0, data: {access_token, refresh_token, user}}" {
        class: success
      }
      frontend.b --> user: "登录成功，跳转首页" {
        class: success
      }
    }
  }
}
