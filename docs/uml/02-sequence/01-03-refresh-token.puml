@startuml OctoTify_Sequence_RefreshToken

skinparam sequenceStyle svg
skinparam linetype ortho

title 刷新令牌 (POST /api/auth/refresh)

actor "前端" as Frontend
participant "HTTPServer" as Server
participant "AuthService" as Auth
participant "JWT Helper" as JWT
database "SQLite" as DB

Frontend -> Server: POST /api/auth/refresh {refreshToken}
activate Server
Server -> Auth: refreshAccessToken(refreshToken)
activate Auth

== 令牌验证 ==

Auth -> JWT: validateToken(refreshToken)
activate JWT

alt 令牌无效
    JWT --> Auth: invalid
    deactivate JWT
    Auth --> Server: ErrRefreshTokenInvalid (110300)
    Server --> Frontend: {code: 110300, msg: "刷新令牌无效"}
    Frontend --> Frontend: 跳转登录页
else 令牌有效
    JWT --> Auth: claims (jti, userId)
    deactivate JWT

    == 数据库检查 ==

    Auth -> DB: SELECT * FROM refresh_tokens WHERE jti = ?
    activate DB
    DB --> Auth: refreshToken / nil
    deactivate DB

    alt 令牌不存在
        Auth --> Server: ErrRefreshTokenInvalid (110300)
        Server --> Frontend: {code: 110300, msg: "刷新令牌无效"}
        Frontend --> Frontend: 跳转登录页
    else 令牌存在
        Auth -> Auth: 检查 revoked（是否已撤销）

        alt 令牌已撤销
            Auth --> Server: ErrRefreshTokenRevoked (110301)
            Server --> Frontend: {code: 110301, msg: "刷新令牌已撤销"}
            Frontend --> Frontend: 跳转登录页
        else 令牌未撤销
            Auth -> Auth: 检查 expires_at（是否已过期）

            alt 令牌已过期
                Auth --> Server: ErrRefreshTokenExpired (110302)
                Server --> Frontend: {code: 110302, msg: "刷新令牌已过期"}
                Frontend --> Frontend: 跳转登录页
            else 令牌未过期

                == 生成新令牌 ==

                Auth -> Auth: 撤销旧 refreshToken
                Auth -> DB: UPDATE refresh_tokens SET revoked = 1
                activate DB
                DB --> Auth: 成功
                deactivate DB
                Auth -> JWT: generateAccessToken(claims)
                activate JWT
                JWT --> Auth: newAccessToken
                deactivate JWT
                Auth -> JWT: generateRefreshToken(claims)
                activate JWT
                JWT --> Auth: newRefreshToken
                deactivate JWT

                alt 新令牌记录失败
                    Auth -> DB: INSERT INTO refresh_tokens (新)
                    activate DB
                    DB --> Auth: 插入失败
                    deactivate DB
                    Auth --> Server: ErrRefreshTokenFailed (110303)
                    Server --> Frontend: {code: 110303, msg: "刷新令牌失败"}
                    Frontend --> Frontend: 跳转登录页
                else 新令牌记录成功
                    Auth -> DB: INSERT INTO refresh_tokens (新)
                    activate DB
                    DB --> Auth: 成功
                    deactivate DB
                    Auth --> Server: TokenPair {newAccessToken, newRefreshToken}
                    deactivate Auth
                    Server --> Frontend: {code: 0, data: {token, refreshToken}}
                    deactivate Server
                end
            end
        end
    end
end

@enduml