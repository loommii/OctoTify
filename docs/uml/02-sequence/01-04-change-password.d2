vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
handler: UserHandler
userService: UserService
db: SQLite

user -> frontend.a: "输入旧密码、新密码"
frontend.a -> server.a: "PUT /api/user/password {old_password, new_password}"
server.a -> handler.a: "changePassword(req)"

参数校验失败: {
  handler.a --> server.a: "{code: 100000, msg: 请求参数格式错误}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100000, msg: 请求参数格式错误}" {
    class: error
  }
  frontend.a --> user: "显示错误提示" {
    class: error
  }
}

参数校验通过: {
  handler.a -> userService.b: "ChangePassword(userId, oldPwd, newPwd)"

  userService.b -> db.b: "SELECT * FROM users WHERE id = ?"

  用户不存在: {
    db.b --> userService.b: "nil"
    userService.b --> handler.b: "ErrChangePasswordFailed (110403)" {
      class: error
    }
    handler.b --> server.b: "{code: 110403, msg: 密码修改失败}" {
      class: error
    }
    server.b --> frontend.b: "{code: 110403, msg: 密码修改失败}" {
      class: error
    }
    frontend.b --> user: "显示错误提示" {
      class: error
    }
  }

  用户存在: {
    db.b --> userService.b: "user"
    userService.b -> userService.b: "bcrypt.CompareHashAndPassword 验证旧密码"

    旧密码错误: {
      userService.b --> handler.b: "ErrChangePasswordOldIncorrect (110402)" {
        class: error
      }
      handler.b --> server.b: "{code: 110402, msg: 旧密码错误}" {
        class: error
      }
      server.b --> frontend.b: "{code: 110402, msg: 旧密码错误}" {
        class: error
      }
      frontend.b --> user: "显示错误提示" {
        class: error
      }
    }

    旧密码正确: {
      userService.b -> userService.b: "bcrypt.GenerateFromPassword 生成新密码哈希"

      数据库更新失败: {
        userService.b -> db.b: "UPDATE users SET password_hash = ? WHERE id = ?"
        db.b --> userService.b: "更新失败"
        userService.b --> handler.b: "ErrChangePasswordFailed (110403)" {
          class: error
        }
        handler.b --> server.b: "{code: 110403, msg: 密码修改失败}" {
          class: error
        }
        server.b --> frontend.b: "{code: 110403, msg: 密码修改失败}" {
          class: error
        }
        frontend.b --> user: "显示错误提示" {
          class: error
        }
      }

      数据库更新成功: {
        userService.b -> db.b: "UPDATE users SET password_hash = ? WHERE id = ?"
        db.b --> userService.b: "成功"
        userService.b -> db.b: "UPDATE refresh_tokens SET revoked = 1 WHERE user_id = ?"
        db.b --> userService.b: "撤销所有 refreshToken 成功"
        userService.b --> handler.b: "成功" {
          class: success
        }
        handler.b --> server.b: "{code: 0, msg: 密码修改成功}" {
          class: success
        }
        server.b --> frontend.b: "{code: 0, msg: 密码修改成功}" {
          class: success
        }
        frontend.b --> user: "密码修改成功，需重新登录" {
          class: success
        }
      }
    }
  }
}

note: "安全说明：修改密码后撤销所有已签发的 Refresh Token，强制用户重新登录" {
  near: bottom-center
}
