@startuml OctoTify_Sequence_Login

skinparam sequenceStyle svg
skinparam linetype ortho

title 登录 (POST /api/auth/login)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "AuthHandler" as Handler
participant "AuthService" as Auth
participant "JWT Helper" as JWT
database "SQLite" as DB

User -> Frontend: 输入用户名、密码
Frontend -> Server: POST /api/auth/login {username, password}
activate Server
Server -> Handler: login(req)
activate Handler

== 参数校验 ==

alt 参数校验失败
    Handler -> Handler: 参数校验（用户名/密码非空）
    Handler --> Server: {code: 110200, msg: "用户名或密码错误"}
    Server --> Frontend: {code: 110200, msg: "用户名或密码错误"}
    Frontend --> User: 显示错误提示
else 参数校验通过
    Handler -> Handler: 参数校验通过
    Handler -> Auth: login(username, password)
    activate Auth

    == 用户验证 ==

    Auth -> DB: SELECT * FROM users WHERE username = ?
    activate DB
    DB --> Auth: user / nil
    deactivate DB

    alt 用户不存在或密码错误
        Auth -> Auth: 验证密码失败
        Auth --> Handler: ErrLoginInvalidCredentials (110200)
        Handler --> Server: {code: 110200, msg: "用户名或密码错误"}
        Server --> Frontend: {code: 110200, msg: "用户名或密码错误"}
        Frontend --> User: 显示错误提示
    else 验证成功
        Auth -> Auth: 验证密码成功

        == 生成令牌 ==

        Auth -> JWT: generateAccessToken(claims)
        activate JWT
        JWT --> Auth: accessToken
        deactivate JWT
        Auth -> JWT: generateRefreshToken(claims)
        activate JWT
        JWT --> Auth: refreshToken
        deactivate JWT

        alt 刷新令牌记录失败
            Auth -> DB: INSERT INTO refresh_tokens
            activate DB
            DB --> Auth: 插入失败
            deactivate DB
            Auth --> Handler: ErrLoginFailed (110201)
            Handler --> Server: {code: 110201, msg: "登录失败"}
            Server --> Frontend: {code: 110201, msg: "登录失败"}
            Frontend --> User: 显示错误提示
        else 刷新令牌记录成功
            Auth -> DB: INSERT INTO refresh_tokens
            activate DB
            DB --> Auth: 成功
            deactivate DB
            Auth --> Handler: TokenPair {accessToken, refreshToken}
            deactivate Auth
            Handler --> Server: {code: 0, data: {token, refreshToken, user}}
            deactivate Handler
            Server --> Frontend: {code: 0, data: {token, refreshToken, user}}
            deactivate Server
            Frontend --> User: 登录成功，跳转首页
        end
    end
end

@enduml