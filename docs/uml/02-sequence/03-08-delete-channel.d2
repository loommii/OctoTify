vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
jwt: JWTAuth 中间件
handler: ChannelHandler
service: ChannelService
db: SQLite

user -> frontend.a: "点击删除"
frontend.a -> server.a: "DELETE /api/channels/:id"
server.a -> jwt.a: "JWTAuth(accessToken)"

未提供认证令牌: {
  jwt.a --> server.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口" {
    class: error
  }
}

令牌无效或已过期: {
  jwt.a --> server.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口" {
    class: error
  }
}

令牌有效: {
  jwt.a --> server.a: "userId (从 claims 中提取)"
  server.a -> handler.a: "deleteChannel(userId, channelId)"
  
  handler.a -> service.a: "getChannelById(channelId, userId)"
  service.a -> db.a: "SELECT * FROM channels WHERE id = ? AND user_id = ?"
  
  渠道不存在: {
    db.a --> service.a: "nil"
    service.a --> handler.a: "ErrChannelNotFound (110603)" {
      class: error
    }
    handler.a --> server.a: "{code: 110603, msg: 渠道不存在}" {
      class: error
    }
    server.a --> frontend.a: "{code: 110603, msg: 渠道不存在}" {
      class: error
    }
    frontend.a --> user: "显示错误提示" {
      class: error
    }
  }
  
  渠道已删除: {
    db.a --> service.a: "channel (status = -1)"
    service.a --> handler.a: "ErrChannelAlreadyDeleted (110609)" {
      class: error
    }
    handler.a --> server.a: "{code: 110609, msg: 渠道已删除}" {
      class: error
    }
    server.a --> frontend.a: "{code: 110609, msg: 渠道已删除}" {
      class: error
    }
    frontend.a --> user: "提示渠道已删除" {
      class: error
    }
  }
  
  渠道存在: {
    db.a --> service.a: "channel"
    service.a --> handler.a: "channel"
    
    handler.a -> service.a: "softDeleteChannel(channelId, userId)"
    
    数据库更新失败: {
      service.a -> db.a: "UPDATE channels SET status = -1, updated_at = ? WHERE id = ? AND user_id = ?"
      db.a --> service.a: "更新失败"
      service.a --> handler.a: "ErrChannelDeleteFailed (110606)" {
        class: error
      }
      handler.a --> server.a: "{code: 110606, msg: 删除渠道失败}" {
        class: error
      }
      server.a --> frontend.a: "{code: 110606, msg: 删除渠道失败}" {
        class: error
      }
      frontend.a --> user: "显示错误提示" {
        class: error
      }
    }
    
    数据库更新成功: {
      service.a -> db.a: "UPDATE channels SET status = -1, updated_at = ? WHERE id = ? AND user_id = ?"
      db.a --> service.a: "成功"
      service.a -> db.a: "DELETE FROM source_channels WHERE channel_id = ?"
      
      删除关联来源失败: {
        db.a --> service.a: "删除失败"
        service.a --> handler.a: "ErrChannelDeleteFailed (110606)" {
          class: error
        }
        handler.a --> server.a: "{code: 110606, msg: 删除渠道失败}" {
          class: error
        }
        server.a --> frontend.a: "{code: 110606, msg: 删除渠道失败}" {
          class: error
        }
        frontend.a --> user: "显示错误提示" {
          class: error
        }
      }
      
      删除关联来源成功: {
        db.a --> service.a: "成功" {
          class: success
        }
        service.a --> handler.a: "成功" {
          class: success
        }
        handler.a --> server.a: "{code: 0, msg: 渠道已删除}" {
          class: success
        }
        server.a --> frontend.a: "{code: 0, msg: 渠道已删除}" {
          class: success
        }
        frontend.a --> user: "渠道已删除（软删除）" {
          class: success
        }
      }
    }
  }
}

note: "软删除说明：Channel 设置 status = -1，同时物理删除 source_channels 关联记录" {
  near: bottom-center
}
