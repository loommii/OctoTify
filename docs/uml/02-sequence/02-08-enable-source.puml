@startuml OctoTify_Sequence_EnableSource

skinparam sequenceStyle svg
skinparam linetype ortho

title 启用消息来源 (PUT /api/sources/:id/enable)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "SourceHandler" as Handler
participant "SourceService" as Service
database "SQLite" as DB

User -> Frontend: 点击启用
Frontend -> Server: PUT /api/sources/:id/enable
note right: Header: Authorization Bearer {accessToken}
activate Server
Server -> Handler: enableSource(userId, sourceId)
activate Handler

== 查询来源 ==

Handler -> Service: getSourceById(sourceId, userId)
activate Service
Service -> DB: SELECT * FROM sources WHERE id = ? AND user_id = ?
activate DB

alt 来源不存在
    DB --> Service: nil
    deactivate DB
    Service --> Handler: ErrSourceNotFound (110503)
    Handler --> Server: {code: 110503, msg: "来源不存在"}
    Server --> Frontend: {code: 110503, msg: "来源不存在"}
    Frontend --> User: 显示错误提示
else 来源已删除
    DB --> Service: source (status = -1)
    deactivate DB
    Service --> Handler: ErrSourceAlreadyDeleted (110509)
    Handler --> Server: {code: 110509, msg: "来源已删除"}
    Server --> Frontend: {code: 110509, msg: "来源已删除"}
    Frontend --> User: 显示错误提示
else 来源已启用
    DB --> Service: source (status = 1)
    deactivate DB
    Service --> Handler: source
    deactivate Service
    Handler -> Handler: 校验状态（status == 1，返回 ErrSourceAlreadyEnabled）
    Handler --> Server: ErrSourceAlreadyEnabled (110508)
    Server --> Frontend: {code: 110508, msg: "来源已启用"}
    Frontend --> User: 提示来源已启用
else 来源已停用
    DB --> Service: source (status = 2)
    deactivate DB
    Service --> Handler: source
    deactivate Service
    Handler -> Handler: 校验状态（status != 1，通过）

    == 更新状态 ==

    Handler -> Service: updateSourceStatus(sourceId, 1, userId)
    activate Service

    alt 数据库更新失败
        Service -> DB: UPDATE sources SET status = 1 WHERE id = ? AND user_id = ?
        activate DB
        DB --> Service: 更新失败
        deactivate DB
        Service --> Handler: ErrSourceQueryFailed (110505)
        Handler --> Server: {code: 110505, msg: "查询来源失败"}
        Server --> Frontend: {code: 110505, msg: "查询来源失败"}
        Frontend --> User: 显示错误提示
    else 数据库更新成功
        Service -> DB: UPDATE sources SET status = 1 WHERE id = ? AND user_id = ?
        activate DB
        DB --> Service: 成功
        deactivate DB
        Service --> Handler: 成功
        deactivate Service
        Handler --> Server: {code: 0}
        deactivate Handler
        Server --> Frontend: {code: 0, msg: "已启用"}
        deactivate Server
        Frontend --> User: 来源已启用
    end
end

@enduml