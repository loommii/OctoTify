@startuml OctoTify_Sequence_ViewChannelDetail

skinparam sequenceStyle svg
skinparam linetype ortho

title 查看渠道详情 (GET /api/channels/:id)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "ChannelHandler" as Handler
participant "ChannelService" as Service
database "SQLite" as DB

User -> Frontend: 点击某个渠道
Frontend -> Server: GET /api/channels/:id
note right: Header: Authorization Bearer {accessToken}
activate Server
Server -> Handler: getChannelDetail(userId, channelId)
activate Handler

== 查询渠道 ==

Handler -> Service: getChannelById(channelId)
activate Service
Service -> DB: SELECT * FROM channels WHERE id = ? AND user_id = ?
activate DB

alt 渠道不存在
    DB --> Service: nil
    deactivate DB
    Service --> Handler: ErrChannelNotFound (110603)
    Handler --> Server: {code: 110603, msg: "渠道不存在"}
    Server --> Frontend: {code: 110603, msg: "渠道不存在"}
    Frontend --> User: 显示错误提示
else 渠道已删除
    DB --> Service: channel (status = -1)
    deactivate DB
    Service --> Handler: ErrChannelAlreadyDeleted (110609)
    Handler --> Server: {code: 110609, msg: "渠道已删除"}
    Server --> Frontend: {code: 110609, msg: "渠道已删除"}
    Frontend --> User: 显示错误提示
else 渠道存在
    DB --> Service: channel
    deactivate DB
    Service --> Handler: channel
    deactivate Service
    Handler --> Server: {code: 0, data: channel}
    deactivate Handler
    Server --> Frontend: {code: 0, data: channel}
    deactivate Server
    Frontend --> User: 显示渠道详情
end

@enduml