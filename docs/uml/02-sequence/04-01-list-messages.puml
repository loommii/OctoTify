@startuml OctoTify_Sequence_ListMessages

skinparam sequenceStyle svg
skinparam linetype ortho

title 查看消息列表 (GET /api/messages)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth 中间件" as JWT
participant "MessageHandler" as Handler
participant "MessageService" as Service
database "SQLite" as DB

User -> Frontend: 访问消息列表页面
Frontend -> Server: GET /api/messages?page=1&pageSize=20
note right: Header: Authorization Bearer {accessToken}\nX-Request-ID: {request_id}
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
    JWT --> Server: {code: 100001, msg: "未提供认证令牌"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "未提供认证令牌"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)\n刷新成功后重试原请求
else 令牌无效或已过期
    JWT --> Server: {code: 100001, msg: "认证令牌无效或已过期"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "认证令牌无效或已过期"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)\n刷新成功后重试原请求
else 令牌有效
    JWT --> Server: userId (从 claims 中提取)
    deactivate JWT
    Server -> Handler: ListMessages(userId, pageReq)
    activate Handler
    Handler -> Service: ListMessages(ctx, userId, pageReq)
    activate Service

    == 查询列表 ==

    alt 查询失败
        Service -> DB: SELECT COUNT(*) FROM messages m INNER JOIN sources s ON m.source_id = s.id WHERE s.user_id = ? AND m.status != -1
        activate DB
        DB --> Service: 查询错误
        deactivate DB
        Service --> Handler: ErrMessageRecordFailed (110704)
        Handler --> Server: {code: 110704, msg: "记录消息状态失败"}
        note right: 日志：查询消息列表失败\nerror_code=110704, request_id={request_id}, userId={userId}
        Server --> Frontend: {code: 110704, msg: "记录消息状态失败"}
        Frontend --> User: 显示错误提示
    else 查询成功
        Service -> DB: SELECT COUNT(*) FROM messages m INNER JOIN sources s ON m.source_id = s.id WHERE s.user_id = ? AND m.status != -1
        activate DB
        DB --> Service: total
        deactivate DB
        Service -> DB: SELECT m.* FROM messages m INNER JOIN sources s ON m.source_id = s.id WHERE s.user_id = ? AND m.status != -1 ORDER BY m.created_at DESC LIMIT ? OFFSET ?
        activate DB
        DB --> Service: messages[]
        deactivate DB
        Service --> Handler: {list, total, page, pageSize}
        deactivate Service
        Handler --> Server: {code: 0, msg: "请求成功", data: {list, total, page, pageSize}}
        note right: 日志：查询消息列表成功\nrequest_id={request_id}, userId={userId}, total={total}
        deactivate Handler
        Server --> Frontend: {code: 0, msg: "请求成功", data: {list, total, page, pageSize}}
        deactivate Server
        Frontend --> User: 显示消息列表
    end
end

@enduml
