@startuml OctoTify_Sequence_CreateChannel

skinparam sequenceStyle svg
skinparam linetype ortho
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 150

title 创建推送渠道 (POST /api/channels)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth\n中间件" as JWT
participant "ChannelHandler" as Handler
participant "ChannelService" as Service
database "SQLite" as DB

User -> Frontend: 选择渠道类型、输入名称、配置
activate Frontend
Frontend -> Server: POST /api/channels {type, name, config}
note right
  Header:
  - Authorization: Bearer {accessToken}
  - X-Request-ID: {request_id}
  Body:
  {
    "type": "feishu",
    "name": "飞书-运维群",
    "config": {
      "webhook_url": "https://...",
      "secret": ""
    }
  }
end note
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
  JWT --> Server: 401 {code: 100001}
  deactivate JWT
  Server --> Frontend: 401 {code: 100001, msg: "未提供认证令牌"}
  Frontend --> User: 跳转登录页
else 令牌无效或已过期
  JWT --> Server: 401 {code: 100001}
  deactivate JWT
  Server --> Frontend: 401 {code: 100001, msg: "认证令牌无效或已过期"}
  Frontend --> Frontend: 使用 Refresh Token 刷新 (POST /api/auth/refresh)
else 令牌有效
  JWT --> Server: userId (从 claims 中提取)
  deactivate JWT
  Server -> Handler: createChannel(userId, req)
  activate Handler

  == 参数校验 ==

  alt 渠道类型无效
    Handler --> Server: {code: 120200, msg: "渠道类型不支持"}
    Server --> Frontend: {code: 120200, msg: "渠道类型不支持"}
    Frontend --> User: 显示错误提示
  else 名称为空或超长
    Handler --> Server: {code: 120201, msg: "渠道名称格式错误"}
    Server --> Frontend: {code: 120201, msg: "渠道名称格式错误"}
    Frontend --> User: 显示错误提示
  else 配置为空
    Handler --> Server: {code: 120202, msg: "渠道配置不能为空"}
    Server --> Frontend: {code: 120202, msg: "渠道配置不能为空"}
    Frontend --> User: 显示错误提示
  else 参数校验通过
    Handler -> Service: CreateChannel(ctx, userId, req)
    activate Service

    alt 渠道名称已存在
      Service --> Handler: {code: 120201, msg: "渠道名称已存在"}
      Handler --> Server: {code: 120201, msg: "渠道名称已存在"}
      Server --> Frontend: {code: 120201, msg: "渠道名称已存在"}
      Frontend --> User: 显示错误提示
    else 数据库插入失败
      Service -> DB: INSERT INTO channels (user_id, type, name, config, status, created_at, updated_at)
      activate DB
      DB --> Service: 插入失败
      deactivate DB
      Service --> Handler: {code: 120202, msg: "创建渠道失败"}
      Handler --> Server: {code: 120202, msg: "创建渠道失败"}
      Server --> Frontend: {code: 120202, msg: "创建渠道失败"}
      Frontend --> User: 显示错误提示
    else 数据库插入成功
      Service -> DB: INSERT INTO channels (user_id, type, name, config, status, created_at, updated_at)
      activate DB
      DB --> Service: channelId
      deactivate DB
      Service -> DB: SELECT * FROM channels WHERE id = ?
      activate DB
      DB --> Service: channel
      deactivate DB
      Service --> Handler: channel
      deactivate Service
      Handler --> Server: {code: 0, data: channel}
      deactivate Handler
      Server --> Frontend: {code: 0, data: channel}
      deactivate Server
      Frontend --> User: 创建成功，跳转列表页
    end
  end
end

@enduml
