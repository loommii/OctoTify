vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
jwt: JWTAuth 中间件
handler: SourceHandler
service: SourceService
db: SQLite

user -> frontend.a: "点击某个来源"
frontend.a -> server.a: "GET /api/sources/:id"
server.a -> jwt.a: "JWTAuth(accessToken)"

未提供认证令牌: {
  jwt.a --> server.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口，刷新成功后重试" {
    class: error
  }
}

令牌无效或已过期: {
  jwt.a --> server.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口，刷新成功后重试" {
    class: error
  }
}

令牌有效: {
  jwt.a --> server.a: "userId (从 claims 中提取)"
  server.a -> handler.a: "GetSourceDetail(userId, sourceId)"

  sourceId格式错误: {
    handler.a --> server.a: "{code: 100000, msg: 来源ID格式错误}" {
      class: error
    }
    server.a --> frontend.a: "{code: 100000, msg: 来源ID格式错误}" {
      class: error
    }
    frontend.a --> user: "显示错误提示" {
      class: error
    }
  }

  参数校验通过: {
    handler.a -> service.b: "GetSourceDetail(ctx, sourceId, userId)"
    service.b -> db.b: "SELECT * FROM sources WHERE id = ? AND user_id = ? AND status != -1"

    查询失败: {
      db.b --> service.b: "查询错误"
      service.b --> handler.b: "ErrSourceQueryFailed (110505)" {
        class: error
      }
      handler.b --> server.b: "{code: 110505, msg: 查询来源失败}" {
        class: error
      }
      server.b --> frontend.b: "{code: 110505, msg: 查询来源失败}" {
        class: error
      }
      frontend.b --> user: "显示错误提示" {
        class: error
      }
    }

    来源不存在或已删除: {
      db.b --> service.b: "nil"
      service.b --> handler.b: "ErrSourceNotFound (110503)" {
        class: error
      }
      handler.b --> server.b: "{code: 110503, msg: 来源不存在}" {
        class: error
      }
      server.b --> frontend.b: "{code: 110503, msg: 来源不存在}" {
        class: error
      }
      frontend.b --> user: "显示错误提示" {
        class: error
      }
    }

    来源存在: {
      db.b --> service.b: "source"

      service.b -> db.b: "SELECT c.* FROM channels c INNER JOIN source_channels sc ON c.id = sc.channel_id WHERE sc.source_id = ? AND c.status != -1"

      查询渠道失败: {
        db.b --> service.b: "查询错误"
        service.b --> handler.b: "ErrChannelQueryFailed (110605)" {
          class: error
        }
        handler.b --> server.b: "{code: 110605, msg: 查询渠道失败}" {
          class: error
        }
        server.b --> frontend.b: "{code: 110605, msg: 查询渠道失败}" {
          class: error
        }
        frontend.b --> user: "显示错误提示" {
          class: error
        }
      }

      查询渠道成功: {
        db.b --> service.b: "channels[]"
        service.b --> handler.b: "{source, channels}" {
          class: success
        }
        handler.b --> server.b: "{code: 0, msg: 请求成功, data: {source, channels}}" {
          class: success
        }
        server.b --> frontend.b: "{code: 0, msg: 请求成功, data: {source, channels}}" {
          class: success
        }
        frontend.b --> user: "显示来源详情和已绑定渠道" {
          class: success
        }
      }
    }
  }
}
