@startuml OctoTify_Sequence_PushMultiChannels

skinparam sequenceStyle svg
skinparam linetype ortho

title 并发推送到多个渠道

participant "MessageService" as Service
participant "SenderFactory" as Factory
participant "Sender" as Sender
participant "MessageRepo" as Repo
database "SQLite" as DB

Service -> Service: 遍历 channels[]
par 并发推送到各渠道 [渠道 1]
    == 创建消息记录（事务） ==

    Service -> Repo: insertMessage(sourceId, channelId, title, content, 100)
    activate Repo
    note over Repo, DB: BEGIN TRANSACTION

    alt 消息记录创建失败
        Repo -> DB: INSERT INTO messages (source_id, channel_id, title, content, status) VALUES (?, ?, ?, ?, 100)
        activate DB
        DB --> Repo: 插入失败
        deactivate DB
        note over Repo, DB: ROLLBACK
        Repo --> Service: ErrMessageRecordFailed (110704)
        deactivate Repo
        Service -> Service: 记录该渠道推送失败
    else 消息记录创建成功
        Repo -> DB: INSERT INTO messages (source_id, channel_id, title, content, status) VALUES (?, ?, ?, ?, 100)
        activate DB
        DB --> Repo: messageId
        deactivate DB
        note over Repo, DB: COMMIT
        Repo --> Service: messageId
        deactivate Repo

        == 获取 Sender ==

        Service -> Factory: create(channel.type)
        activate Factory

        alt 不支持的渠道类型
            Factory --> Service: nil
            deactivate Factory
            Service -> Repo: updateMessageStatus(messageId, 300)
            activate Repo
            note over Repo, DB: BEGIN TRANSACTION
            Repo -> DB: UPDATE messages SET status = 300 WHERE id = ?
            activate DB
            DB --> Repo: 成功
            deactivate DB
            note over Repo, DB: COMMIT
            Repo --> Service: 成功
            deactivate Repo
        else Sender 创建成功
            Factory --> Service: sender
            deactivate Factory

            == 推送消息 ==

            Service -> Sender: send(channel.config, message)
            activate Sender
            Sender -> Sender: 调用渠道API推送消息

            alt 推送失败（网络错误/超时/API错误）
                Sender --> Service: 失败 (error)
                deactivate Sender
                Service -> Repo: updateMessageStatus(messageId, 300)
                activate Repo
                note over Repo, DB: BEGIN TRANSACTION
                Repo -> DB: UPDATE messages SET status = 300 WHERE id = ?
                activate DB
                DB --> Repo: 成功
                deactivate DB
                note over Repo, DB: COMMIT
                Repo --> Service: 成功
                deactivate Repo
            else 推送成功
                Sender --> Service: 成功
                deactivate Sender
                Service -> Repo: updateMessageStatus(messageId, 200)
                activate Repo
                note over Repo, DB: BEGIN TRANSACTION
                Repo -> DB: UPDATE messages SET status = 200 WHERE id = ?
                activate DB
                DB --> Repo: 成功
                deactivate DB
                note over Repo, DB: COMMIT
                Repo --> Service: 成功
                deactivate Repo
            end
        end
    end
else 并发推送到各渠道 [渠道 2]
    == 创建消息记录（事务） ==

    Service -> Repo: insertMessage(sourceId, channelId, title, content, 100)
    activate Repo
    note over Repo, DB: BEGIN TRANSACTION

    alt 消息记录创建失败
        Repo -> DB: INSERT INTO messages (source_id, channel_id, title, content, status) VALUES (?, ?, ?, ?, 100)
        activate DB
        DB --> Repo: 插入失败
        deactivate DB
        note over Repo, DB: ROLLBACK
        Repo --> Service: ErrMessageRecordFailed (110704)
        deactivate Repo
        Service -> Service: 记录该渠道推送失败
    else 消息记录创建成功
        Repo -> DB: INSERT INTO messages (source_id, channel_id, title, content, status) VALUES (?, ?, ?, ?, 100)
        activate DB
        DB --> Repo: messageId
        deactivate DB
        note over Repo, DB: COMMIT
        Repo --> Service: messageId
        deactivate Repo

        == 获取 Sender ==

        Service -> Factory: create(channel.type)
        activate Factory
        Factory --> Service: sender
        deactivate Factory

        == 推送消息 ==

        Service -> Sender: send(channel.config, message)
        activate Sender
        Sender -> Sender: 调用渠道API推送消息

        alt 推送失败
            Sender --> Service: 失败 (error)
            deactivate Sender
            Service -> Repo: updateMessageStatus(messageId, 300)
            activate Repo
            note over Repo, DB: BEGIN TRANSACTION
            Repo -> DB: UPDATE messages SET status = 300 WHERE id = ?
            activate DB
            DB --> Repo: 成功
            deactivate DB
            note over Repo, DB: COMMIT
            Repo --> Service: 成功
            deactivate Repo
        else 推送成功
            Sender --> Service: 成功
            deactivate Sender
            Service -> Repo: updateMessageStatus(messageId, 200)
            activate Repo
            note over Repo, DB: BEGIN TRANSACTION
            Repo -> DB: UPDATE messages SET status = 200 WHERE id = ?
            activate DB
            DB --> Repo: 成功
            deactivate DB
            note over Repo, DB: COMMIT
            Repo --> Service: 成功
            deactivate Repo
        end
    end
end
Service --> Service: 汇总推送结果 (成功数/失败数)

@enduml