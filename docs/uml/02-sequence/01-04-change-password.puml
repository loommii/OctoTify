@startuml OctoTify_Sequence_ChangePassword

skinparam sequenceStyle svg
skinparam linetype ortho

title 修改密码 (PUT /api/user/password)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "AuthHandler" as Handler
participant "AuthService" as Auth
database "SQLite" as DB

User -> Frontend: 输入旧密码、新密码
Frontend -> Server: PUT /api/user/password {old_password, new_password}
note right: Header: Authorization Bearer {accessToken}
activate Server
Server -> Handler: changePassword(req)
activate Handler

== 参数校验（gin binding + 自定义 validator） ==

alt 参数校验失败
    Handler --> Server: {code: 100000, msg: "请求参数格式错误"}
    Server --> Frontend: {code: 100000, msg: "请求参数格式错误"}
    Frontend --> User: 显示错误提示
else 参数校验通过
    Handler -> Auth: changePassword(userId, oldPwd, newPwd)
    activate Auth

    == 验证旧密码 ==

    Auth -> DB: SELECT * FROM users WHERE id = ?
    activate DB
    DB --> Auth: user
    deactivate DB

    alt 用户不存在
        Auth --> Handler: ErrChangePasswordFailed (110403)
        Handler --> Server: {code: 110403, msg: "密码修改失败"}
        Server --> Frontend: {code: 110403, msg: "密码修改失败"}
        Frontend --> User: 显示错误提示
    else 用户存在
        Auth -> Auth: 验证旧密码

        alt 旧密码错误
            Auth --> Handler: ErrChangePasswordOldIncorrect (110402)
            Handler --> Server: {code: 110402, msg: "旧密码错误"}
            Server --> Frontend: {code: 110402, msg: "旧密码错误"}
            Frontend --> User: 显示错误提示
        else 旧密码正确
            Auth -> Auth: 新密码哈希

            alt 数据库更新失败
                Auth -> DB: UPDATE users SET password_hash = ? WHERE id = ?
                activate DB
                DB --> Auth: 更新失败
                deactivate DB
                Auth --> Handler: ErrChangePasswordFailed (110403)
                Handler --> Server: {code: 110403, msg: "密码修改失败"}
                Server --> Frontend: {code: 110403, msg: "密码修改失败"}
                Frontend --> User: 显示错误提示
            else 数据库更新成功
                Auth -> DB: UPDATE users SET password_hash = ? WHERE id = ?
                activate DB
                DB --> Auth: 成功
                deactivate DB
                Auth -> DB: UPDATE refresh_tokens SET revoked = 1 WHERE user_id = ?
                activate DB
                DB --> Auth: 撤销所有 refreshToken
                deactivate DB
                note right: Access Token 在过期前仍有效\n（JWT 无状态特性，最长 1 小时后自动失效）
                Auth --> Handler: 成功
                deactivate Auth
                Handler --> Server: {code: 0, msg: "密码修改成功"}
                deactivate Handler
                Server --> Frontend: {code: 0, msg: "密码修改成功"}
                deactivate Server
                Frontend --> User: 密码修改成功，需重新登录
            end
        end
    end
end

@enduml
