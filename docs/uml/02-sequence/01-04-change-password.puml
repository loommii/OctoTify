@startuml OctoTify_Sequence_ChangePassword

skinparam sequenceStyle svg
skinparam linetype ortho

title 修改密码 (POST /api/user/password)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "UserService" as UserSvc
database "SQLite" as DB

User -> Frontend: 输入旧密码、新密码
Frontend -> Server: POST /api/user/password {oldPassword, newPassword}
note right: Header: Authorization Bearer {accessToken}
activate Server
Server -> UserSvc: changePassword(userId, oldPwd, newPwd)
activate UserSvc

== 参数校验 ==

alt 旧密码为空
    UserSvc --> Server: ErrChangePasswordOldEmpty (110400)
    Server --> Frontend: {code: 110400, msg: "旧密码不能为空"}
    Frontend --> User: 显示错误提示
else 新密码为空
    UserSvc --> Server: ErrChangePasswordNewEmpty (110401)
    Server --> Frontend: {code: 110401, msg: "新密码不能为空"}
    Frontend --> User: 显示错误提示
else 参数校验通过
    UserSvc -> DB: SELECT * FROM users WHERE id = ?
    activate DB

    alt 用户不存在
        DB --> UserSvc: nil
        deactivate DB
        UserSvc --> Server: ErrChangePasswordFailed (110403)
        Server --> Frontend: {code: 110403, msg: "密码修改失败"}
        Frontend --> User: 显示错误提示
    else 用户存在
        DB --> UserSvc: user
        deactivate DB

        == 验证旧密码 ==

        UserSvc -> UserSvc: 验证旧密码

        alt 旧密码错误
            UserSvc --> Server: ErrChangePasswordOldIncorrect (110402)
            Server --> Frontend: {code: 110402, msg: "旧密码错误"}
            Frontend --> User: 显示错误提示
        else 旧密码正确
            UserSvc -> UserSvc: 新密码哈希

            alt 数据库更新失败
                UserSvc -> DB: UPDATE users SET password_hash = ?
                activate DB
                DB --> UserSvc: 更新失败
                deactivate DB
                UserSvc --> Server: ErrChangePasswordFailed (110403)
                Server --> Frontend: {code: 110403, msg: "密码修改失败"}
                Frontend --> User: 显示错误提示
            else 数据库更新成功
                UserSvc -> DB: UPDATE users SET password_hash = ?
                activate DB
                DB --> UserSvc: 成功
                deactivate DB
                UserSvc -> DB: UPDATE refresh_tokens SET revoked = 1 WHERE user_id = ?
                activate DB
                DB --> UserSvc: 撤销所有 refreshToken
                deactivate DB
                note right: Access Token 在过期前仍有效\n（JWT 无状态特性，最长 1 小时后自动失效）
                UserSvc --> Server: 成功
                deactivate UserSvc
                Server --> Frontend: {code: 0, msg: "密码修改成功"}
                deactivate Server
                Frontend --> User: 密码修改成功，需重新登录
            end
        end
    end
end

@enduml