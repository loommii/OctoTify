vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
jwt: JWTAuth 中间件
handler: SourceHandler
service: SourceService
db: SQLite

user -> frontend.a: "访问消息来源页面"
frontend.a -> server.a: "GET /api/sources?page=1&pageSize=20"
server.a -> jwt.a: "JWTAuth(accessToken)"

未提供认证令牌: {
  jwt.a --> server.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口，刷新成功后重试" {
    class: error
  }
}

令牌无效或已过期: {
  jwt.a --> server.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口，刷新成功后重试" {
    class: error
  }
}

令牌有效: {
  jwt.a --> server.a: "userId (从 claims 中提取)"
  server.a -> handler.a: "ListSources(userId, pageReq)"
  handler.a -> service.b: "ListSources(ctx, userId, pageReq)"

  查询失败: {
    service.b -> db.b: "SELECT * FROM sources WHERE user_id = ? AND status != -1 ORDER BY created_at DESC LIMIT ? OFFSET ?"
    db.b --> service.b: "查询错误"
    service.b --> handler.b: "ErrSourceQueryFailed (110505)" {
      class: error
    }
    handler.b --> server.b: "{code: 110505, msg: 查询来源失败}" {
      class: error
    }
    server.b --> frontend.b: "{code: 110505, msg: 查询来源失败}" {
      class: error
    }
    frontend.b --> user: "显示错误提示" {
      class: error
    }
  }

  查询成功: {
    service.b -> db.b: "SELECT COUNT(*) FROM sources WHERE user_id = ? AND status != -1"
    db.b --> service.b: "total"
    service.b -> db.b: "SELECT * FROM sources WHERE user_id = ? AND status != -1 ORDER BY created_at DESC LIMIT ? OFFSET ?"
    db.b --> service.b: "sources[]"
    service.b --> handler.b: "{list, total, page, pageSize}" {
      class: success
    }
    handler.b --> server.b: "{code: 0, msg: 请求成功, data: {list, total, page, pageSize}}" {
      class: success
    }
    server.b --> frontend.b: "{code: 0, msg: 请求成功, data: {list, total, page, pageSize}}" {
      class: success
    }
    frontend.b --> user: "显示来源列表（分页）" {
      class: success
    }
  }
}
