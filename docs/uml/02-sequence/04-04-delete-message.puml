@startuml OctoTify_Sequence_DeleteMessage

skinparam sequenceStyle svg
skinparam linetype ortho

title 删除消息记录 (DELETE /api/messages/:id)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth 中间件" as JWT
participant "MessageHandler" as Handler
participant "MessageService" as Service
database "SQLite" as DB

User -> Frontend: 点击删除消息
Frontend -> Frontend: 弹出确认对话框
User -> Frontend: 确认删除
Frontend -> Server: DELETE /api/messages/:id
note right: Header: Authorization Bearer {accessToken}\nX-Request-ID: {request_id}
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
    JWT --> Server: {code: 100001, msg: "未提供认证令牌"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "未提供认证令牌"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)\n刷新成功后重试原请求
else 令牌无效或已过期
    JWT --> Server: {code: 100001, msg: "认证令牌无效或已过期"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "认证令牌无效或已过期"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)\n刷新成功后重试原请求
else 令牌有效
    JWT --> Server: userId (从 claims 中提取)
    deactivate JWT
    Server -> Handler: DeleteMessage(userId, messageId)
    activate Handler

    == 参数校验 ==

    alt messageId 格式错误
        Handler --> Server: {code: 100000, msg: "无效的消息 ID"}
        Server --> Frontend: {code: 100000, msg: "无效的消息 ID"}
        Frontend --> User: 显示错误提示
    else 参数校验通过

        == 查询消息 ==

        Handler -> Service: DeleteMessage(ctx, userId, messageId)
        activate Service

        Service -> DB: SELECT m.* FROM messages m INNER JOIN sources s ON m.source_id = s.id WHERE s.user_id = ? AND m.id = ?
        activate DB

        alt 查询失败
            DB --> Service: 查询错误
            deactivate DB
            Service --> Handler: ErrMessageRecordFailed (110704)
            Handler --> Server: {code: 110704, msg: "记录消息状态失败"}
            note right: 日志：查询消息失败\nerror_code=110704, request_id={request_id}, messageId={messageId}
            Server --> Frontend: {code: 110704, msg: "记录消息状态失败"}
            Frontend --> User: 显示错误提示
        else 消息不存在
            DB --> Service: nil
            deactivate DB
            Service --> Handler: ErrNotFound (100003)
            Handler --> Server: {code: 100003, msg: "资源不存在"}
            note right: 日志：消息不存在\nerror_code=100003, request_id={request_id}, messageId={messageId}
            Server --> Frontend: {code: 100003, msg: "资源不存在"}
            Frontend --> User: 显示消息不存在提示
        else 消息已删除
            DB --> Service: message (status = -1)
            deactivate DB
            Service --> Handler: ErrMessageAlreadyDeleted (110705)
            Handler --> Server: {code: 110705, msg: "消息已删除"}
            note right: 日志：消息已删除\nerror_code=110705, request_id={request_id}, messageId={messageId}
            Server --> Frontend: {code: 110705, msg: "消息已删除"}
            Frontend --> User: 提示消息已删除
        else 消息存在
            DB --> Service: message
            deactivate DB

            == 软删除消息 ==

            Service -> DB: BEGIN TRANSACTION
            activate DB

            Service -> DB: UPDATE messages SET status = -1, updated_at = ? WHERE id = ?
            activate DB

            alt 删除失败
                DB --> Service: 更新失败
                deactivate DB
                Service -> DB: ROLLBACK
                Service --> Handler: ErrMessageRecordFailed (110704)
                Handler --> Server: {code: 110704, msg: "记录消息状态失败"}
                note right: 日志：删除消息失败\nerror_code=110704, request_id={request_id}, messageId={messageId}
                Server --> Frontend: {code: 110704, msg: "记录消息状态失败"}
                Frontend --> User: 显示错误提示
            else 删除成功
                DB --> Service: 成功
                deactivate DB
                Service -> DB: COMMIT
                deactivate DB
                Service --> Handler: 成功
                deactivate Service
                Handler --> Server: {code: 0, msg: "请求成功"}
                note right: 日志：消息已删除\nrequest_id={request_id}, messageId={messageId}
                deactivate Handler
                Server --> Frontend: {code: 0, msg: "请求成功"}
                deactivate Server
                Frontend --> User: 消息已删除
            end
        end
    end
end

@enduml
