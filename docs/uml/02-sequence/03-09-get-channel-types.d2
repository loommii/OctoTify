vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
jwt: JWTAuth 中间件
handler: ChannelHandler
service: ChannelService

user -> frontend.a: "打开创建渠道页面"
frontend.a -> server.a: "GET /api/channel-types"
server.a -> jwt.a: "JWTAuth(accessToken)"

未提供认证令牌: {
  jwt.a --> server.a: "401 {code: 100001}" {
    class: error
  }
  server.a --> frontend.a: "401 {code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  frontend.a --> user: "跳转登录页" {
    class: error
  }
}

令牌无效或已过期: {
  jwt.a --> server.a: "401 {code: 100001}" {
    class: error
  }
  server.a --> frontend.a: "401 {code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 刷新" {
    class: error
  }
}

令牌有效: {
  jwt.a --> server.a: "userId (从 claims 中提取)"
  server.a -> handler.a: "GetChannelTypes()"
  handler.a -> service.a: "GetChannelTypes()"
  
  service.a -> service.a: "遍历 ChannelTypeMetas 注册表"
  service.a --> handler.a: "[]ChannelTypeMeta" {
    class: success
  }
  handler.a --> server.a: "{code: 0, data: channelTypes}" {
    class: success
  }
  server.a --> frontend.a: "{code: 0, data: channelTypes}" {
    class: success
  }
  
  frontend.a -> frontend.a: "根据 config_fields JSON Schema 动态渲染表单"
  frontend.a --> user: "展示渠道类型选择和配置表单" {
    class: success
  }
}

note: "无数据库查询：渠道类型从内存中的 ChannelTypeMetas 注册表读取" {
  near: bottom-center
}
