@startuml OctoTify_Sequence_EditSource

skinparam sequenceStyle svg
skinparam linetype ortho

title 编辑消息来源 (PUT /api/sources/:id)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "JWTAuth 中间件" as JWT
participant "SourceHandler" as Handler
participant "SourceService" as Service
database "SQLite" as DB

User -> Frontend: 修改名称、描述
Frontend -> Server: PUT /api/sources/:id {name, description}
note right: Header: Authorization Bearer {accessToken}\nX-Request-ID: {request_id}
activate Server

== JWT 认证中间件拦截 ==

Server -> JWT: JWTAuth(accessToken)
activate JWT

alt 未提供认证令牌
    JWT --> Server: {code: 100001, msg: "未提供认证令牌"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "未提供认证令牌"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌无效或已过期
    JWT --> Server: {code: 100001, msg: "认证令牌无效或已过期"}
    deactivate JWT
    Server --> Frontend: {code: 100001, msg: "认证令牌无效或已过期"}
    Frontend --> Frontend: 使用 Refresh Token 调用刷新接口 (POST /api/auth/refresh)
else 令牌有效
    JWT --> Server: userId (从 claims 中提取)
    deactivate JWT
    Server -> Handler: updateSource(userId, sourceId, req)
    activate Handler

    == 参数校验 ==

    alt 参数校验失败
        Handler --> Server: {code: 110500, msg: "来源名称不能为空"}
        Server --> Frontend: {code: 110500, msg: "来源名称不能为空"}
        Frontend --> User: 显示错误提示
    else 参数校验通过

        == 查询来源 ==

        Handler -> Service: getSourceById(sourceId, userId)
        activate Service
        Service -> DB: SELECT * FROM sources WHERE id = ? AND user_id = ?
        activate DB

        alt 来源不存在
            DB --> Service: nil
            deactivate DB
            Service --> Handler: ErrSourceNotFound (110503)
            Handler --> Server: {code: 110503, msg: "来源不存在"}
            note right: 日志：来源不存在\nerror_code=110503, sourceId=1, request_id={request_id}
            Server --> Frontend: {code: 110503, msg: "来源不存在"}
            Frontend --> User: 显示错误提示
        else 来源已删除
            DB --> Service: source (status = -1)
            deactivate DB
            Service --> Handler: ErrSourceAlreadyDeleted (110509)
            Handler --> Server: {code: 110509, msg: "来源已删除"}
            note right: 日志：来源已删除\nerror_code=110509, sourceId=1, request_id={request_id}
            Server --> Frontend: {code: 110509, msg: "来源已删除"}
            Frontend --> User: 显示错误提示
        else 来源存在且有效
            DB --> Service: source
            deactivate DB
            Service --> Handler: source
            deactivate Service

            == 更新来源（事务） ==

            Handler -> Service: updateSource(sourceId, name, description, userId)
            activate Service
            note over Service, DB: BEGIN TRANSACTION

            alt 数据库更新失败
                Service -> DB: UPDATE sources SET name = ?, description = ?, updated_at = ? WHERE id = ? AND user_id = ?
                activate DB
                DB --> Service: 更新失败
                deactivate DB
                note over Service, DB: ROLLBACK
                Service --> Handler: ErrSourceUpdateFailed (110510)
                Handler --> Server: {code: 110510, msg: "更新来源失败"}
                note right: 日志：更新来源失败\nerror_code=110510, sourceId=1, request_id={request_id}
                Server --> Frontend: {code: 110510, msg: "更新来源失败"}
                Frontend --> User: 显示错误提示
            else 数据库更新成功
                Service -> DB: UPDATE sources SET name = ?, description = ?, updated_at = ? WHERE id = ? AND user_id = ?
                activate DB
                DB --> Service: 成功
                deactivate DB
                note over Service, DB: COMMIT
                Service --> Handler: 成功
                deactivate Service
                Handler --> Server: {code: 0}
                deactivate Handler
                note right: 日志：来源更新成功\nsourceId=1, name=xxx, request_id={request_id}
                Server --> Frontend: {code: 0, msg: "更新成功"}
                deactivate Server
                Frontend --> User: 编辑成功
            end
        end
    end
end

@enduml
