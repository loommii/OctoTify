@startuml OctoTify_Sequence_DeleteChannel

skinparam sequenceStyle svg
skinparam linetype ortho

title 删除推送渠道 (DELETE /api/channels/:id)

actor "用户" as User
participant "前端" as Frontend
participant "HTTPServer" as Server
participant "ChannelHandler" as Handler
participant "ChannelService" as Service
database "SQLite" as DB

User -> Frontend: 点击删除
Frontend -> Server: DELETE /api/channels/:id
note right: Header: Authorization Bearer {accessToken}
activate Server
Server -> Handler: deleteChannel(userId, channelId)
activate Handler

== 查询渠道 ==

Handler -> Service: getChannelById(channelId, userId)
activate Service
Service -> DB: SELECT * FROM channels WHERE id = ? AND user_id = ?
activate DB

alt 渠道不存在
    DB --> Service: nil
    deactivate DB
    Service --> Handler: ErrChannelNotFound (110603)
    Handler --> Server: {code: 110603, msg: "渠道不存在"}
    Server --> Frontend: {code: 110603, msg: "渠道不存在"}
    Frontend --> User: 显示错误提示
else 渠道已删除
    DB --> Service: channel (status = -1)
    deactivate DB
    Service --> Handler: channel
    deactivate Service
    Handler -> Handler: 校验状态（status == -1，返回 ErrChannelAlreadyDeleted）
    Handler --> Server: ErrChannelAlreadyDeleted (110609)
    Server --> Frontend: {code: 110609, msg: "渠道已删除"}
    Frontend --> User: 提示渠道已删除
else 渠道存在
    DB --> Service: channel
    deactivate DB
    Service --> Handler: channel
    deactivate Service
    Handler -> Handler: 校验状态（status != -1，通过）

    == 软删除渠道（事务） ==

    Handler -> Service: softDeleteChannel(channelId, userId)
    activate Service
    note over Service, DB: BEGIN TRANSACTION

    alt 数据库更新失败
        Service -> DB: UPDATE channels SET status = -1 WHERE id = ? AND user_id = ?
        activate DB
        DB --> Service: 更新失败
        deactivate DB
        note over Service, DB: ROLLBACK
        Service --> Handler: ErrChannelDeleteFailed (110606)
        Handler --> Server: {code: 110606, msg: "删除渠道失败"}
        Server --> Frontend: {code: 110606, msg: "删除渠道失败"}
        Frontend --> User: 显示错误提示
    else 数据库更新成功
        Service -> DB: UPDATE channels SET status = -1 WHERE id = ? AND user_id = ?
        activate DB
        DB --> Service: 成功
        deactivate DB
        Service -> DB: DELETE FROM source_channels WHERE channel_id = ?
        activate DB

        alt 删除关联来源失败
            DB --> Service: 删除失败
            deactivate DB
            note over Service, DB: ROLLBACK
            Service --> Handler: ErrChannelDeleteFailed (110606)
            Handler --> Server: {code: 110606, msg: "删除渠道失败"}
            Server --> Frontend: {code: 110606, msg: "删除渠道失败"}
            Frontend --> User: 显示错误提示
        else 删除关联来源成功
            DB --> Service: 成功
            deactivate DB
            note over Service, DB: COMMIT
            Service --> Handler: 成功
            deactivate Service
            Handler --> Server: {code: 0}
            deactivate Handler
            Server --> Frontend: {code: 0, msg: "已删除"}
            deactivate Server
            Frontend --> User: 渠道已删除
        end
    end
end

@enduml