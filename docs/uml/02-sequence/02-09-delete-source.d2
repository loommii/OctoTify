vars: {
  d2-config: {
    layout-engine: elk
  }
}

shape: sequence_diagram

classes: {
  success: {
    style.stroke: "#28a745"
    style.animated: true
  }
  error: {
    style.stroke: "#dc3545"
    style.stroke-dash: 3
    style.animated: true
  }
}

user: 用户
frontend: 前端
server: HTTPServer
jwt: JWTAuth 中间件
handler: SourceHandler
service: SourceService
db: SQLite

user -> frontend.a: "点击删除"
frontend.a -> frontend.a: "弹出密码输入框"
frontend.a --> user: "要求输入密码验证身份"
user -> frontend.a: "输入密码"
frontend.a -> server.a: "DELETE /api/sources/:id {password}"
server.a -> jwt.a: "JWTAuth(accessToken)"

未提供认证令牌: {
  jwt.a --> server.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 未提供认证令牌}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口" {
    class: error
  }
}

令牌无效或已过期: {
  jwt.a --> server.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  server.a --> frontend.a: "{code: 100001, msg: 认证令牌无效或已过期}" {
    class: error
  }
  frontend.a --> frontend.a: "使用 Refresh Token 调用刷新接口" {
    class: error
  }
}

令牌有效: {
  jwt.a --> server.a: "userId (从 claims 中提取)"
  server.a -> handler.a: "deleteSource(userId, sourceId, password)"

  handler.a -> service.b: "verifyPassword(userId, password)"
  service.b -> db.b: "SELECT password_hash FROM users WHERE id = ?"

  密码验证失败: {
    db.b --> service.b: "password_hash"
    service.b -> service.b: "bcrypt.CompareHashAndPassword 验证失败"
    service.b --> handler.b: "ErrUnauthorized (100001)" {
      class: error
    }
    handler.b --> server.b: "{code: 100001, msg: 密码错误}" {
      class: error
    }
    server.b --> frontend.b: "{code: 100001, msg: 密码错误}" {
      class: error
    }
    frontend.b --> user: "显示密码错误提示" {
      class: error
    }
  }

  密码验证成功: {
    db.b --> service.b: "password_hash"
    service.b -> service.b: "bcrypt.CompareHashAndPassword 验证成功"
    service.b --> handler.b: "验证成功"

    handler.b -> service.b: "getSourceById(sourceId, userId)"
    service.b -> db.b: "SELECT * FROM sources WHERE id = ? AND user_id = ?"

    来源不存在: {
      db.b --> service.b: "nil"
      service.b --> handler.b: "ErrSourceNotFound (110503)" {
        class: error
      }
      handler.b --> server.b: "{code: 110503, msg: 来源不存在}" {
        class: error
      }
      server.b --> frontend.b: "{code: 110503, msg: 来源不存在}" {
        class: error
      }
      frontend.b --> user: "显示错误提示" {
        class: error
      }
    }

    来源已删除: {
      db.b --> service.b: "source (status = -1)"
      service.b --> handler.b: "ErrSourceAlreadyDeleted (110509)" {
        class: error
      }
      handler.b --> server.b: "{code: 110509, msg: 来源已删除}" {
        class: error
      }
      server.b --> frontend.b: "{code: 110509, msg: 来源已删除}" {
        class: error
      }
      frontend.b --> user: "提示来源已删除" {
        class: error
      }
    }

    来源存在: {
      db.b --> service.b: "source"
      service.b --> handler.b: "source"

      handler.b -> service.b: "softDeleteSource(sourceId, userId)"

      service.b -> db.b: "UPDATE sources SET status = -1, updated_at = ? WHERE id = ? AND user_id = ?"

      删除来源失败: {
        db.b --> service.b: "更新失败"
        service.b --> handler.b: "ErrSourceDeleteFailed (110506)" {
          class: error
        }
        handler.b --> server.b: "{code: 110506, msg: 删除来源失败}" {
          class: error
        }
        server.b --> frontend.b: "{code: 110506, msg: 删除来源失败}" {
          class: error
        }
        frontend.b --> user: "显示错误提示" {
          class: error
        }
      }

      删除来源成功: {
        db.b --> service.b: "成功"

        service.b -> db.b: "UPDATE source_channels SET status = -1 WHERE source_id = ?"

        删除关联渠道失败: {
          db.b --> service.b: "更新失败"
          service.b --> handler.b: "ErrSourceDeleteFailed (110506)" {
            class: error
          }
          handler.b --> server.b: "{code: 110506, msg: 删除来源失败}" {
            class: error
          }
          server.b --> frontend.b: "{code: 110506, msg: 删除来源失败}" {
            class: error
          }
          frontend.b --> user: "显示错误提示" {
            class: error
          }
        }

        删除关联渠道成功: {
          db.b --> service.b: "成功"
          service.b --> handler.b: "成功" {
            class: success
          }
          handler.b --> server.b: "{code: 0}" {
            class: success
          }
          server.b --> frontend.b: "{code: 0, msg: 已删除}" {
            class: success
          }
          frontend.b --> user: "来源已删除（软删除）" {
            class: success
          }
        }
      }
    }
  }
}

note: "软删除说明：Source 和关联 source_channels 均设置 status = -1，不物理删除" {
  near: bottom-center
}
